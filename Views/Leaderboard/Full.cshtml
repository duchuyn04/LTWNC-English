@model ltwnc.Models.ViewModels.Leaderboard.LeaderboardPageViewModel
@{
    // FILE: Bảng xếp hạng học tập — LeaderboardController.Full AllowAnonymous.
    // Model: LeaderboardPageViewModel (PeriodDays, Entries top 20, ViewerEntry, TotalEntryCount).
    // Xếp theo tổng DurationSeconds phiên Completed + profile IsPublic.
    // Kỳ: 7 / 30 ngày (query ?period=); CSS leaderboard.css.
    ViewData["Title"] = "Bảng xếp hạng";
    string PeriodLink(int period) => $"/Leaderboard/Full?period={period}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/leaderboard.css" asp-append-version="true" />
}

<div class="lb-production">
    <header class="lb-header">
        <div>
            <span class="lb-eyebrow">Bảng xếp hạng học tập</span>
            <h1>Ai dành nhiều thời gian học nhất?</h1>
            <p>Tổng hợp thời gian học chủ động của những người đã bật hiển thị thống kê.</p>
        </div>
        <nav class="lb-period" aria-label="Chọn khoảng thời gian">
            <a class="@(Model.PeriodDays == 7 ? "active" : null)"
               href="@PeriodLink(7)"
               aria-current="@(Model.PeriodDays == 7 ? "page" : null)">7 ngày</a>
            <a class="@(Model.PeriodDays == 30 ? "active" : null)"
               href="@PeriodLink(30)"
               aria-current="@(Model.PeriodDays == 30 ? "page" : null)">30 ngày</a>
        </nav>
    </header>

    @if (Model.IsEmpty)
    {
        <section class="lb-empty" aria-labelledby="lb-empty-title">
            <i class="ph ph-hourglass-medium" aria-hidden="true"></i>
            <h2 id="lb-empty-title">@Model.EmptyMessage</h2>
            <p>Hãy hoàn thành một buổi học và bật “Hiển thị thống kê” trong hồ sơ để xuất hiện trên bảng.</p>
        </section>
    }
    else
    {
        var champion = Model.Entries[0];
        <section class="lb-podium" aria-label="Ba vị trí dẫn đầu">
            <article class="lb-champion">
                <div class="lb-medal lb-medal--gold">
                    <i class="ph ph-medal" aria-hidden="true"></i>
                    <span>Hạng 1</span>
                </div>
                <div class="lb-rank-mark">01</div>
                <div class="lb-avatar lb-avatar--large" aria-hidden="true">@champion.AvatarInitial</div>
                <div>
                    <span class="lb-small-label">Dẫn đầu @(Model.PeriodDays == 0 ? "mọi thời gian" : $"{Model.PeriodDays} ngày")</span>
                    <h2>@champion.Username</h2>
                    <strong>@Duration(champion.TotalSeconds)</strong>
                    <small>@champion.SessionCount buổi học</small>
                </div>
            </article>
            @if (Model.Entries.Count > 1)
            {
                <div class="lb-podium-side">
                    @for (var i = 1; i < Math.Min(3, Model.Entries.Count); i++)
                    {
                        var entry = Model.Entries[i];
                        <article class="lb-runner">
                            <span class="lb-rank-mark">@((i + 1).ToString("00"))</span>
                            <span class="lb-avatar" aria-hidden="true">@entry.AvatarInitial</span>
                            <span>
                                <strong>@entry.Username</strong>
                                <small>@entry.SessionCount buổi học</small>
                            </span>
                            <b>@Duration(entry.TotalSeconds)</b>
                        </article>
                    }
                </div>
            }
        </section>

        @if (Model.ViewerEntry is not null && Model.ViewerEntry.Rank > Model.Entries.Count)
        {
            var viewer = Model.ViewerEntry;
            <section class="lb-current" aria-label="Vị trí của bạn">
                <span class="lb-current-label">Vị trí của bạn</span>
                <span class="lb-current-rank">#@viewer.Rank</span>
                <span class="lb-person">
                    <span class="lb-avatar" aria-hidden="true">@viewer.AvatarInitial</span>
                    <span>
                        <strong>@viewer.Username</strong>
                        <small>@viewer.SessionCount buổi học</small>
                    </span>
                </span>
                <span class="lb-current-progress">Bạn đang nằm ngoài top 20</span>
                <span class="lb-duration">@Duration(viewer.TotalSeconds)</span>
            </section>
        }

        @if (Model.Entries.Count > 3)
        {
            <ol class="lb-list" start="4" aria-label="Các vị trí từ 4 đến 20">
                @for (var i = 3; i < Model.Entries.Count; i++)
                {
                    var entry = Model.Entries[i];
                    <li class="lb-row @(entry.IsViewer ? "is-viewer" : null)">
                        <span class="lb-row-rank">@entry.Rank.ToString("00")</span>
                        <span class="lb-person">
                            <span class="lb-avatar" aria-hidden="true">@entry.AvatarInitial</span>
                            <span>
                                <strong>@entry.Username</strong>
                                <small>@entry.SessionCount buổi học</small>
                            </span>
                        </span>
                        <span class="lb-duration">@Duration(entry.TotalSeconds)</span>
                    </li>
                }
            </ol>
        }
    }
</div>

@functions {
    private static string Duration(long seconds)
    {
        var duration = TimeSpan.FromSeconds(seconds);
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours} giờ {duration.Minutes:00} phút"
            : $"{duration.Minutes} phút";
    }
}
