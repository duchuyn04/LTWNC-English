@model ReviewSetViewModel
@{
    // FILE: Hub Review 1 bộ thẻ — ReviewController Set/{id} [Authorize].
    // Model: ReviewSetViewModel (due/new counts, settings, set meta, active session?).
    // Start: POST Start → ReviewService.StartAsync(userId, setId) — State machine + quota thẻ mới/ngày.
    // HideLayoutChrome + review.css; partial _SettingsPanel nhúng cài đặt.
    // 1 user chỉ 1 session Review active (unique index DB).
    // Timezone quota: Asia/Ho_Chi_Minh (backend).
    ViewData["Title"] = "Ôn tập đến hạn";
    ViewData["HideLayoutChrome"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/review.css" asp-append-version="true" />
}

@section FullWidth {
<div class="review-focus">
    <div class="review-focus__shell">
        <header class="review-focus__header">
            <a class="review-focus__back" href="/Set">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span>Quay lại bộ thẻ</span>
            </a>
            <span class="review-focus__brand">Ôn tập ngắt quãng</span>
            @await Html.PartialAsync("_SettingsPanel", new ReviewSettingsPanelViewModel
            {
                SetId = Model.SetId,
                Settings = Model.Settings
            })
        </header>

        <section class="review-focus__intro" aria-labelledby="review-intro-title">
            <div>
                <p class="review-focus__eyebrow">@Model.SetTitle · Focus Deck</p>
                <h1 class="review-focus__intro-title" id="review-intro-title">Ôn lại trước khi quên.</h1>
                <p class="review-focus__intro-lede">
                    Một lượt ôn ngắn, tập trung vào những thẻ đã đến hạn trước rồi mới thêm thẻ mới khi còn chỗ.
                </p>
            </div>
            <div class="review-focus__intro-card">
                <div class="review-focus__intro-card-heading">
                    <span class="review-focus__intro-card-icon" aria-hidden="true">
                        <i class="ph ph-timer"></i>
                    </span>
                    <div>
                        <strong>Nhịp ôn của bạn</strong>
                        <p>Phiên tiếp theo</p>
                    </div>
                </div>
                <dl class="review-focus__intro-stats">
                    <div>
                        <dt>Đến hạn</dt>
                        <dd>@Model.DueCards</dd>
                    </div>
                    <div>
                        <dt>Thẻ mới</dt>
                        <dd>@Model.NewCards</dd>
                    </div>
                    <div>
                        <dt>Tối đa</dt>
                        <dd>@Model.Settings.ReviewSessionSize</dd>
                    </div>
                </dl>
            </div>
        </section>

        @if (TempData["Message"] is string message)
        {
            <div class="review-focus__notice" data-popup="info" role="status">@message</div>
        }

        <section class="review-focus__start-card" aria-labelledby="review-start-title">
            <div>
                <h2 id="review-start-title">Bắt đầu lượt ôn</h2>
                <p>Thẻ đến hạn được ưu tiên trước, sau đó thêm tối đa @Model.Settings.NewCardQuota thẻ mới của riêng bộ này trong ngày.</p>
            </div>
            <div class="review-focus__start-card-actions">
                <form method="post" action="/Review/Set/@Model.SetId/Start">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="review-focus__primary">
                        <span>Bắt đầu ôn tập</span>
                        <i class="ph ph-arrow-right" aria-hidden="true"></i>
                    </button>
                </form>
            </div>
        </section>
    </div>
</div>
}
