@model ReviewSessionViewModel

@{
    // FILE: Phiên ôn đang chạy — ReviewController Session + Rate.
    // Model: ReviewSessionViewModel (Cards, RatedCards, Settings, SessionId).
    // Chọn card chưa rate; form POST /Review/{id}/Rate name=rating Again|Hard|Good|Easy.
    // Settings ShowFront*/ShowBack* điều khiển mặt trước/sau (giống flashcard settings).
    // data-review-session + JS shortcut 1-4; End sớm POST End (giữ quota thẻ mới đã assign).
    // Backend ReviewStateMachine: New/Learning/Reviewing/Relearning (pattern State).
    ViewData["Title"] = "Ôn tập đến hạn";
    // Ẩn chrome layout — màn focus full-width (@section FullWidth).
    ViewData["HideLayoutChrome"] = true;

    // Ưu tiên thẻ chưa rate; fallback thẻ đầu (session rỗng/lỗi).
    ReviewCardViewModel? card = Model.Cards.FirstOrDefault(value => !value.IsRated)
        ?? Model.Cards.FirstOrDefault();
    // Preview khoảng lặp lại sau mỗi rating (backend tính trước, UI hiện dưới nút).
    ReviewRatingPreviewViewModel? againPreview = card?.RatingPreviews.FirstOrDefault(value => value.Rating == ReviewRating.Again);
    ReviewRatingPreviewViewModel? hardPreview = card?.RatingPreviews.FirstOrDefault(value => value.Rating == ReviewRating.Hard);
    ReviewRatingPreviewViewModel? goodPreview = card?.RatingPreviews.FirstOrDefault(value => value.Rating == ReviewRating.Good);
    ReviewRatingPreviewViewModel? easyPreview = card?.RatingPreviews.FirstOrDefault(value => value.Rating == ReviewRating.Easy);

    // Số thứ tự thẻ đang làm (1-based); progress bar theo RatedCards/TotalCards.
    int currentNumber = Model.TotalCards == 0
        ? 0
        : Math.Min(Model.RatedCards + 1, Model.TotalCards);
    int progressPercent = Model.TotalCards == 0
        ? 0
        : (int)Math.Round(Model.RatedCards * 100d / Model.TotalCards);
    // Session scoped theo set → về hub set; legacy multi-set → /Review.
    string backUrl = Model.SetId.HasValue
        ? $"/Review/Set/{Model.SetId.Value}"
        : "/Review";

    // Nhãn stage hiện tại của ReviewProgress (State pattern).
    string StageLabel(ReviewStage stage) => stage switch
    {
        ReviewStage.New => "Thẻ mới",
        ReviewStage.Learning => "Đang học",
        ReviewStage.Relearning => "Học lại",
        _ => "Đang ôn"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/review.css" asp-append-version="true" />
}

@section FullWidth {
<div class="review-focus">
    <div class="review-focus__shell">
        <header class="review-focus__session-header">
            <a class="review-focus__header-action review-focus__session-back" href="@backUrl">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span class="review-focus__back-label-long">Quay lại bộ thẻ</span>
                <span class="review-focus__back-label-short">Bộ thẻ</span>
            </a>
            <div class="review-focus__session-heading">
                <span class="review-focus__eyebrow">Ôn tập ngắt quãng</span>
                <h1 class="review-focus__session-title">Phiên ôn tập</h1>
            </div>
            <div class="review-focus__session-header-end" role="group" aria-label="Tùy chọn phiên ôn tập">
                @if (Model.SetId.HasValue)
                {
                    @await Html.PartialAsync("_SettingsPanel", new ReviewSettingsPanelViewModel
                    {
                        SetId = Model.SetId.Value,
                        Settings = Model.Settings
                    })
                }
                <form method="post"
                      action="/Review/@Model.SessionId/End"
                      class="review-focus__end-form"
                      data-confirm="Kết thúc sớm lượt ôn?">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="review-focus__header-action">
                        <i class="ph ph-sign-out" aria-hidden="true"></i>
                        <span>Kết thúc sớm</span>
                    </button>
                </form>
            </div>
        </header>

        <div class="review-focus__progress" aria-label="Tiến độ lượt ôn">
            <div class="review-focus__progress-label">
                <span>@Model.RatedCards / @Model.TotalCards thẻ đã hoàn thành</span>
                <strong>@progressPercent%</strong>
            </div>
            <div class="review-focus__progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progressPercent">
                <span class="review-focus__progress-value" style="width: @(progressPercent)%"></span>
            </div>
        </div>

        @if (card is not null)
        {
            <article class="review-focus__card" data-review-session data-state="question">
                <div class="review-focus__card-topline">
                    <div class="review-focus__card-context">
                        <span class="review-focus__tag">@card.SetTitle</span>
                        <span class="review-focus__stage">@StageLabel(card.Stage)</span>
                    </div>
                    <span class="review-focus__session-count" aria-label="Thẻ hiện tại">
                        <small>Thẻ</small> @currentNumber.ToString("00")<span>/@Model.TotalCards.ToString("00")</span>
                    </span>
                </div>

                <div class="review-focus__study-surface">
                    <div class="review-focus__question">
                        <div class="review-focus__prompt">
                            <span class="review-focus__label">Mặt trước</span>
                            @if (Model.Settings.ShowFrontTerm)
                            {
                                <h2 class="review-focus__prompt-text">@card.FrontText</h2>
                            }
                            @if (Model.Settings.ShowFrontDefinition)
                            {
                                <p class="review-focus__prompt-text">@card.BackText</p>
                            }
                            @if (Model.Settings.ShowFrontIpa && !string.IsNullOrWhiteSpace(card.Pronunciation))
                            {
                                <p class="review-focus__pronunciation">
                                    <span>@card.Pronunciation</span>
                                    <button type="button" class="review-focus__icon-button" aria-label="Nghe phát âm">
                                        <i class="ph ph-speaker-high" aria-hidden="true"></i>
                                    </button>
                                </p>
                            }
                        </div>

                        @if (!Model.Settings.HideImage && Model.Settings.ShowFrontImage
                            && (!string.IsNullOrWhiteSpace(card.UploadedImagePath)
                                || !string.IsNullOrWhiteSpace(card.ImageUrl)))
                        {
                            <img class="review-focus__card-image @(Model.Settings.BlurImage ? "review-focus__card-image--blurred" : null)"
                                 src="@(card.UploadedImagePath ?? card.ImageUrl)"
                                 alt="Ảnh minh họa cho @card.FrontText" />
                        }
                    </div>

                    <div id="review-answer" class="review-focus__answer" aria-live="polite" tabindex="-1" hidden>
                        <span class="review-focus__label">Đáp án</span>
                        @if (Model.Settings.ShowBackTerm)
                        {
                            <strong class="review-focus__answer-main">@card.FrontText</strong>
                        }
                        @if (Model.Settings.ShowBackDefinition)
                        {
                            <strong class="review-focus__answer-main">@card.BackText</strong>
                        }
                        @if (Model.Settings.ShowBackIpa && !string.IsNullOrWhiteSpace(card.Pronunciation))
                        {
                            <p class="review-focus__answer-meaning">@card.Pronunciation</p>
                        }
                        @if (Model.Settings.ShowBackExample && !string.IsNullOrWhiteSpace(card.ExampleSentence))
                        {
                            <p class="review-focus__answer-example">@card.ExampleSentence</p>
                            <p class="review-focus__answer-meaning">@card.ExampleMeaning</p>
                        }
                        @if (!Model.Settings.HideImage && Model.Settings.ShowBackImage
                            && (!string.IsNullOrWhiteSpace(card.UploadedImagePath)
                                || !string.IsNullOrWhiteSpace(card.ImageUrl)))
                        {
                            <img class="review-focus__card-image @(Model.Settings.BlurImage ? "review-focus__card-image--blurred" : null)"
                                 src="@(card.UploadedImagePath ?? card.ImageUrl)"
                                 alt="Ảnh minh họa cho @card.FrontText" />
                        }
                    </div>
                </div>

                <div class="review-focus__interaction">
                    <div class="review-focus__divider">
                        <span id="review-guidance">Tự nhớ trước khi xem đáp án</span>
                    </div>

                    <button id="review-reveal" type="button" class="review-focus__reveal" aria-controls="review-answer" aria-expanded="false">
                        <i class="ph ph-eye" aria-hidden="true"></i>
                        <span>Hiện đáp án</span>
                    </button>

                    <form id="review-rating-form" method="post" action="/Review/@Model.SessionId/Rate" class="review-focus__rating-form js-rate-form" hidden>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="flashcardId" value="@card.FlashcardId" />
                        <input id="answer-revealed" type="hidden" name="answerRevealed" value="false" />
                        <div class="review-focus__ratings" role="group" aria-label="Chọn mức nhớ">
                            <button class="review-focus__rating review-focus__rating--again js-rating"
                                    type="submit" name="rating" value="Again" data-shortcut="1" disabled>
                                <kbd aria-hidden="true">1</kbd>
                                <span><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>Quên</span>
                                <small>@againPreview?.DelayLabel</small>
                            </button>
                            <button class="review-focus__rating review-focus__rating--hard js-rating"
                                    type="submit" name="rating" value="Hard" data-shortcut="2" disabled>
                                <kbd aria-hidden="true">2</kbd>
                                <span><i class="ph ph-minus-circle" aria-hidden="true"></i>Khó</span>
                                <small>@hardPreview?.DelayLabel</small>
                            </button>
                            <button class="review-focus__rating review-focus__rating--good js-rating"
                                    type="submit" name="rating" value="Good" data-shortcut="3" disabled>
                                <kbd aria-hidden="true">3</kbd>
                                <span><i class="ph ph-check-circle" aria-hidden="true"></i>Tốt</span>
                                <small>@goodPreview?.DelayLabel</small>
                            </button>
                            <button class="review-focus__rating review-focus__rating--easy js-rating"
                                    type="submit" name="rating" value="Easy" data-shortcut="4" disabled>
                                <kbd aria-hidden="true">4</kbd>
                                <span><i class="ph ph-lightning" aria-hidden="true"></i>Dễ</span>
                                <small>@easyPreview?.DelayLabel</small>
                            </button>
                        </div>
                    </form>

                    <div class="review-focus__interaction-meta">
                        <p class="review-focus__status-message" id="review-status" aria-live="polite">
                            <i class="ph ph-info" aria-hidden="true"></i>
                            <span>Tự trả lời trong đầu, sau đó hiện đáp án.</span>
                        </p>
                        <p class="review-focus__hint">
                            <span data-review-hint-before><kbd>Space</kbd> Hiện đáp án</span>
                            <span data-review-hint-after hidden><kbd>1–4</kbd> Chọn mức nhớ</span>
                        </p>
                    </div>
                </div>
            </article>
        }
        else
        {
            <div class="review-focus__card review-focus__empty" role="status">
                Chưa có thẻ nào trong lượt ôn này.
            </div>
        }
    </div>
</div>
}

@section Scripts {
<script>
(() => {
    const root = document.querySelector('[data-review-session]');
    if (!root) return;

    const answer = root.querySelector('#review-answer');
    const reveal = root.querySelector('#review-reveal');
    const answerRevealed = root.querySelector('#answer-revealed');
    const rateForm = root.querySelector('.js-rate-form');
    const ratingButtons = Array.from(root.querySelectorAll('.js-rating'));
    const status = root.querySelector('#review-status span');
    const guidance = root.querySelector('#review-guidance');
    const hintBefore = root.querySelector('[data-review-hint-before]');
    const hintAfter = root.querySelector('[data-review-hint-after]');
    const shortcutKeys = ['1', '2', '3', '4'];
    let revealed = false;

    function revealAnswer() {
        if (revealed || !answer || !reveal || !answerRevealed) return;

        revealed = true;
        root.dataset.state = 'answer';
        answer.hidden = false;
        answerRevealed.value = 'true';
        reveal.disabled = true;
        reveal.hidden = true;
        reveal.setAttribute('aria-expanded', 'true');
        reveal.classList.add('is-revealed');
        if (rateForm) rateForm.hidden = false;
        ratingButtons.forEach((button) => button.disabled = false);
        if (guidance) guidance.textContent = 'Bạn nhớ từ này ở mức nào?';
        if (status) status.textContent = 'Chọn mức nhớ để lên lịch ôn tiếp theo.';
        if (hintBefore) hintBefore.hidden = true;
        if (hintAfter) hintAfter.hidden = false;
        answer.focus({ preventScroll: true });
    }

    reveal.addEventListener('click', revealAnswer);

    window.addEventListener('keydown', (event) => {
        const target = event.target;
        if (target instanceof HTMLElement && target.matches('input, textarea, select, [contenteditable="true"]')) return;

        if (event.code === 'Space') {
            event.preventDefault();
            revealAnswer();
            return;
        }

        const shortcutIndex = shortcutKeys.indexOf(event.key);
        if (shortcutIndex === -1 || !revealed || !rateForm) return;

        event.preventDefault();
        const button = ratingButtons[shortcutIndex];
        if (button) rateForm.requestSubmit(button);
    });
})();
</script>
}
