@model FlashcardStudyViewModel
@{
    // FILE: Học lật thẻ — StudyController Flashcard mode [Authorize phần lớn].
    // Model: FlashcardStudyViewModel (SetId, cards, settings, vocabulary list).
    // HideLayoutChrome; AntiForgeryToken root cho AJAX ToggleStar/SaveSettings.
    // Cuối trang: @Html.Raw(JsonSerializer.Serialize(...)) nhúng data cho JS (không XSS nếu serialize đúng).
    // Settings panel: filter StarredOnly/UnlearnedOnly, mặt trước/sau, ẩn ảnh — POST /Study/Settings.
    // CSS/JS: flashcard.css + inline/adjacent script; Strategy FlashcardModeStrategy chọn thẻ.
    // Partial điều hướng mode: thường dùng _StudyModeNavigation ở header.
    ViewData["Title"] = "Học flashcard";
    // Fullscreen study — layout ẩn nav (xem _Layout hideLayoutChrome).
    ViewData["HideLayoutChrome"] = true;
}

<link rel="stylesheet" href="~/css/flashcard.css" asp-append-version="true" />

<div class="study-shell">
    @Html.AntiForgeryToken()

    <section id="study-view" class="study-stage" aria-label="Học flashcard">
        <header class="study-page-header">
            <a class="study-back" href="/Set" title="Backspace: quay lại danh sách bộ thẻ">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span>Quay lại</span>
            </a>

            <nav class="study-breadcrumb" aria-label="Breadcrumb">
                <a href="/Set">Bộ thẻ của tôi</a>
                <i class="ph ph-caret-right" aria-hidden="true"></i>
                <a href="/Set/@Model.SetId">@Model.SetTitle</a>
                <i class="ph ph-caret-right" aria-hidden="true"></i>
                <span aria-current="page">Học</span>
            </nav>

            <div class="study-title-row">
                <div class="set-meta">
                    <span class="study-title-kicker">Bộ từ đang học</span>
                    <h1 class="set-title">@Model.SetTitle</h1>
                </div>

                <div class="study-title-actions">
                    <a class="study-edit-link" href="/Set/@Model.SetId/Edit">
                        <i class="ph ph-pencil-simple" aria-hidden="true"></i>
                        <span>Chỉnh sửa bộ từ</span>
                    </a>
                    <button type="button" class="icon-button study-settings-button" onclick="toggleSettingsDrawer(event)" title="Cài đặt học" aria-label="Mở cài đặt học" aria-expanded="false" aria-controls="study-settings-drawer">
                        <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </header>

        @if (TempData["Message"] is string message)
        {
            <div class="study-status" data-popup="info">
                <i class="ph ph-info" aria-hidden="true"></i>
                <span>@message</span>
            </div>
        }

        <div class="study-focus-column">
            <div class="progress-strip">
                <span class="progress-label">Tiến độ</span>
                <span id="card-progress-text" class="progress-text">Thẻ 1 / 1</span>
                <div class="progress-track" aria-hidden="true">
                    <div id="card-progress-fill" class="progress-fill"></div>
                </div>
            </div>

        <main class="card-area">
            <div class="flashcard-frame" onclick="toggleCardFlip()" role="button" tabindex="0" aria-label="Lật thẻ">
                <div id="study-card-core" class="flashcard-core">
                    <article class="card-face card-front">
                        <button type="button" class="card-star-btn" onclick="toggleCurrentCardStar(event)" title="Đánh dấu sao">
                            <i class="ph ph-star" aria-hidden="true"></i>
                        </button>
                        <div class="card-topline">
                            <span id="card-front-badge" class="badge badge-blue">English</span>
                        </div>
                        <div class="card-content">
                            <span id="card-front-text" class="card-word card-word-front">Loading...</span>
                            <p id="card-front-ipa" class="card-detail-text" hidden></p>
                            <p id="card-front-definition" class="card-detail-text" hidden></p>
                            <img id="card-front-image" class="card-study-image" alt="Ảnh minh họa mặt trước" hidden />
                        </div>
                        <div class="card-audio-controls" onclick="event.stopPropagation()">
                            <button type="button" class="card-audio-btn" onclick="playAudioCurrentCard()" title="Phát giọng đọc (Ctrl)">
                                <i class="ph ph-speaker-high" aria-hidden="true"></i>
                            </button>
                        </div>
                    </article>

                    <article class="card-face card-back">
                        <button type="button" class="card-star-btn" onclick="toggleCurrentCardStar(event)" title="Đánh dấu sao">
                            <i class="ph ph-star" aria-hidden="true"></i>
                        </button>
                        <div class="card-topline">
                            <span id="card-back-badge" class="badge badge-green">Nghĩa Việt</span>
                        </div>
                        <div class="card-content">
                            <span id="card-back-text" class="card-word card-word-back">Loading...</span>
                            <p id="card-back-term" class="card-detail-text" hidden></p>
                            <p id="card-back-ipa" class="card-detail-text" hidden></p>
                            <p id="card-back-example" class="card-detail-text" hidden></p>
                            <img id="card-back-image" class="card-study-image" alt="Ảnh minh họa mặt sau" hidden />
                        </div>
                        <div class="card-audio-controls" onclick="event.stopPropagation()">
                            <button type="button" class="card-audio-btn" onclick="playAudioCurrentCard()" title="Phát giọng đọc (Ctrl)">
                                <i class="ph ph-speaker-high" aria-hidden="true"></i>
                            </button>
                        </div>
                    </article>
                </div>
            </div>
        </main>

        <div class="control-bar" aria-label="Điều khiển học">
            <span id="dock-progress-text" class="control-progress" aria-live="polite">1 / 1</span>

            <button type="button"
                    id="nav-left-btn"
                    class="control-btn control-btn-prev"
                    onclick="handleLeftAction()"
                    title="Thẻ trước (←)"
                    aria-label="Chuyển đến thẻ trước">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
            </button>

            <div class="control-center">
                <button type="button" id="flip-btn" class="control-btn control-btn-flip" onclick="toggleCardFlip()" title="Lật thẻ (Space)">
                    <i class="ph ph-arrows-counter-clockwise" aria-hidden="true"></i>
                    <span>Lật thẻ</span>
                </button>

                <div id="rating-group" class="rating-group" hidden>
                    <button type="button" class="control-btn control-btn-rate control-btn-rate-unknown" onclick="markCard(false)" title="Chưa biết (1)">
                        <i class="ph ph-x" aria-hidden="true"></i>
                        <span>Chưa biết</span>
                    </button>
                    <button type="button" class="control-btn control-btn-rate control-btn-rate-known" onclick="markCard(true)" title="Đã biết (2)">
                        <i class="ph ph-check" aria-hidden="true"></i>
                        <span>Đã biết</span>
                    </button>
                </div>
            </div>

            <button type="button"
                    id="nav-right-btn"
                    class="control-btn control-btn-next"
                    onclick="handleRightAction()"
                    title="Thẻ tiếp (→)"
                    aria-label="Chuyển đến thẻ tiếp theo">
                <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </button>
        </div>

        <p class="keyboard-hint">
            <span class="keyboard-group"><kbd>Space</kbd> lật</span>
            <span class="keyboard-divider" aria-hidden="true"></span>
            <span class="keyboard-group"><kbd>←</kbd><kbd>→</kbd> chuyển thẻ</span>
            <span class="keyboard-divider" aria-hidden="true"></span>
            <span class="keyboard-group"><kbd>1</kbd> chưa biết</span>
            <span class="keyboard-group"><kbd>2</kbd> đã biết</span>
            <span class="keyboard-divider" aria-hidden="true"></span>
            <span class="keyboard-group"><kbd>Backspace</kbd> thoát</span>
        </p>
        </div>

        <aside class="study-sidebar" aria-label="Công cụ học tập">
            @await Html.PartialAsync("_StudyModeNavigation", Model)

            <section class="study-vocabulary-section" aria-labelledby="study-vocabulary-title">
            <header class="study-vocabulary-header">
                <div>
                    <h2 id="study-vocabulary-title">Danh sách từ</h2>
                    <p>@Model.VocabularyCards.Count thẻ · xem nhanh nội dung trong bộ</p>
                </div>
                <div class="vocab-panel-toolbar">
                    <select id="vocab-sort" class="form-select vocab-sort-select" aria-label="Sắp xếp từ vựng">
                        <option value="original">Tất cả thẻ</option>
                        <option value="starred">Đã đánh dấu trước</option>
                        <option value="unlearned">Chưa học trước</option>
                        <option value="learning">Đang học trước</option>
                        <option value="mastered">Đã thành thạo trước</option>
                    </select>
                </div>
            </header>

            <div id="vocab-list" class="vocab-list"></div>
            </section>
        </aside>
    </section>

    <aside id="study-settings-drawer" class="study-settings-drawer" role="dialog" aria-modal="true" aria-labelledby="settings-title" hidden>
        <div class="settings-drawer-header">
            <div>
                <h2 id="settings-title" class="settings-title">Cài đặt học</h2>
                <p class="settings-subtitle">Thay đổi được lưu tự động</p>
            </div>
            <button type="button" class="icon-button settings-close" onclick="toggleSettingsDrawer(event)" title="Đóng" aria-label="Đóng cài đặt học">
                <i class="ph ph-x" aria-hidden="true"></i>
            </button>
        </div>

        <div class="settings-drawer-body">
            <section class="settings-section" aria-labelledby="settings-filter-title">
                <div class="settings-section-heading">
                    <h3 id="settings-filter-title">Chọn thẻ để học</h3>
                    <p>Để trống để học toàn bộ thẻ</p>
                </div>
                <div class="settings-options settings-options-compact">
                    <label class="settings-option"><span>Chỉ thẻ đánh dấu sao</span><input type="checkbox" data-setting="StarredOnly"></label>
                    <label class="settings-option"><span>Chỉ thẻ chưa thuộc</span><input type="checkbox" data-setting="UnlearnedOnly"></label>
                </div>
            </section>

            <section class="settings-section" aria-labelledby="settings-content-title">
                <div class="settings-section-heading">
                    <h3 id="settings-content-title">Thứ tự ngôn ngữ</h3>
                    <p>Chọn ngôn ngữ bạn muốn thấy trước</p>
                </div>
                <div class="settings-language-order" role="group" aria-label="Thứ tự ngôn ngữ trên thẻ">
                    <button type="button" data-language-order="en-vi" onclick="applyLanguageOrder('en-vi')" aria-pressed="false">Anh → Việt</button>
                    <button type="button" data-language-order="vi-en" onclick="applyLanguageOrder('vi-en')" aria-pressed="false">Việt → Anh</button>
                </div>

                <details class="settings-advanced">
                    <summary>Tùy chỉnh nội dung từng mặt</summary>
                    <div class="settings-side-grid">
                        <fieldset class="settings-card">
                            <legend id="settings-front-title">Mặt trước</legend>
                            <label class="settings-option"><span>Tiếng Anh</span><input type="checkbox" data-setting="ShowFrontTerm"></label>
                            <label class="settings-option"><span>Tiếng Việt</span><input type="checkbox" data-setting="ShowFrontDefinition"></label>
                            <label class="settings-option"><span>Phiên âm IPA</span><input type="checkbox" data-setting="ShowFrontIpa"></label>
                            <label class="settings-option"><span>Hình ảnh</span><input type="checkbox" data-setting="ShowFrontImage"></label>
                        </fieldset>

                        <fieldset class="settings-card">
                            <legend id="settings-back-title">Mặt sau</legend>
                            <label class="settings-option"><span>Tiếng Anh</span><input type="checkbox" data-setting="ShowBackTerm"></label>
                            <label class="settings-option"><span>Tiếng Việt</span><input type="checkbox" data-setting="ShowBackDefinition"></label>
                            <label class="settings-option"><span>Phiên âm IPA</span><input type="checkbox" data-setting="ShowBackIpa"></label>
                            <label class="settings-option"><span>Hình ảnh</span><input type="checkbox" data-setting="ShowBackImage"></label>
                            <label class="settings-option"><span>Ví dụ</span><input type="checkbox" data-setting="ShowBackExample"></label>
                        </fieldset>
                    </div>
                </details>
            </section>

            <section class="settings-section" aria-labelledby="settings-image-title">
                <div class="settings-section-heading">
                    <h3 id="settings-image-title">Hình ảnh</h3>
                </div>
                <div class="settings-options settings-options-compact">
                    <label class="settings-option"><span>Tắt toàn bộ ảnh</span><input type="checkbox" data-setting="HideImage"></label>
                    <label class="settings-option"><span>Che mờ ảnh</span><input type="checkbox" data-setting="BlurImage"></label>
                    <label class="settings-option"><span>Hiển thị ảnh lớn</span><input type="checkbox" data-setting="LargeImage"></label>
                </div>
            </section>

            <section class="settings-section" aria-labelledby="settings-audio-title">
                <div class="settings-section-heading">
                    <h3 id="settings-audio-title">Giọng đọc</h3>
                </div>
                <div class="settings-audio-grid">
                    <div class="tts-row">
                        <label for="tts-voice-select">Giọng tiếng Anh</label>
                        <select id="tts-voice-select" class="form-select premium-select"></select>
                    </div>
                    <div class="tts-row">
                        <label for="tts-speed">Tốc độ</label>
                        <select id="tts-speed" class="form-select premium-select">
                            <option value="0.8">0.8x</option>
                            <option value="1.0" selected>1.0x</option>
                            <option value="1.2">1.2x</option>
                        </select>
                    </div>
                </div>
                <label class="settings-option settings-autoplay"><span>Tự phát khi lật thẻ</span><input type="checkbox" id="tts-autoplay" checked></label>
            </section>
        </div>
    </aside>
    <div id="settings-drawer-backdrop" class="settings-drawer-backdrop" hidden onclick="toggleSettingsDrawer(event)"></div>

    <section id="completion-view" class="completion-view" aria-label="Hoàn thành">
        <div class="completion-inner">
            <span class="badge badge-green">Đã hoàn thành bộ thẻ</span>
            <h2 class="completion-title">Hoàn thành phiên học</h2>
            <p class="completion-copy">
                Tiến độ của bạn đã được ghi nhận. Xem nhanh nhóm thẻ đã biết và nhóm cần ôn lại bên dưới.
            </p>

            <div class="stats-grid">
                <div class="stat-card is-green">
                    <span id="count-learned" class="stat-number">0</span>
                    <span class="stat-label">Đã biết</span>
                </div>
                <div class="stat-card is-red">
                    <span id="count-unlearned" class="stat-number">0</span>
                    <span class="stat-label">Cần ôn</span>
                </div>
            </div>

            <div class="completion-actions">
                <button type="button" class="study-button is-red" onclick="restartStudy()">
                    <span>Ôn lại</span>
                    <span class="button-icon"><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i></span>
                </button>
                <button type="button" class="primary-dark" onclick="completeStudySession()">
                    Về trang học
                </button>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        // === Bridge Razor → JS ===
        // JsonSerializer + Html.Raw: JSON an toàn (escape <>&); KHÔNG nối string user thô.
        // flashcards: payload học; Image ưu tiên upload local hơn URL ngoài.
        let flashcards = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Flashcards.Select(c => new
        {
            c.Id,
            c.FrontText,
            c.BackText,
            c.Pronunciation,
            c.ExampleSentence,
            c.ExampleMeaning,
            c.IsStarred,
            Image = !string.IsNullOrWhiteSpace(c.UploadedImagePath) ? c.UploadedImagePath : c.ImageUrl
        })));
        // UserStudySettings: filter sao/chưa học + layout mặt trước/sau + ảnh.
        const initialSettings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Settings));
        const isAuthenticated = @Json.Serialize(Model.IsAuthenticated);
        const settings = { ...initialSettings };
        // setId/sessionId dùng AJAX ToggleStar, complete session, save settings.
        const setId = @Model.SetId;
        const sessionId = @Model.SessionId;
        const vocabularyCards = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VocabularyCards.Select(c =>
        {
            Model.ProgressByCardId.TryGetValue(c.Id, out var progress);
            return new
            {
                c.Id,
                c.FrontText,
                c.BackText,
                c.Pronunciation,
                c.PartOfSpeech,
                c.ExampleSentence,
                c.Synonyms,
                c.IsStarred,
                c.OrderIndex,
                Status = progress == null ? 0 : (int)progress.Status,
                CorrectCount = progress == null ? 0 : progress.CorrectCount,
                WrongCount = progress == null ? 0 : progress.WrongCount
            };
        })));

        let currentIndex = 0;
        let isFlipped = false;
        let progressMode = false;

        const sessionStats = {
            learned: new Set(),
            unlearned: new Set()
        };

        let voices = [];
        const synth = window.speechSynthesis;
        const voiceSelect = document.getElementById('tts-voice-select');
        const autoplayCheckbox = document.getElementById('tts-autoplay');
        const speedSelect = document.getElementById('tts-speed');

        function exitStudy() {
            window.location.href = '/Set';
        }

        function loadVoices() {
            if (!synth || !voiceSelect) return;

            voices = synth.getVoices();
            voiceSelect.innerHTML = '';

            const enVoices = voices.filter(v => v.lang.startsWith('en'));

            if (enVoices.length === 0) {
                const opt = document.createElement('option');
                opt.textContent = 'Mặc định hệ thống';
                opt.value = 'default';
                voiceSelect.appendChild(opt);
            } else {
                enVoices.forEach(voice => {
                    const opt = document.createElement('option');
                    opt.value = voice.name;
                    opt.textContent = `${voice.name} (${voice.lang})`;
                    if (voice.name.toLowerCase().includes('zira') || voice.name.toLowerCase().includes('female')) {
                        opt.selected = true;
                    }
                    voiceSelect.appendChild(opt);
                });
            }

            restoreTtsSettings();
        }

        if (synth) {
            if (synth.onvoiceschanged !== undefined) {
                synth.onvoiceschanged = loadVoices;
            }
            loadVoices();
        }

        function saveTtsSettings() {
            if (!voiceSelect || !autoplayCheckbox || !speedSelect) return;
            localStorage.setItem('ltwnc_tts_settings', JSON.stringify({
                autoplay: autoplayCheckbox.checked,
                voiceName: voiceSelect.value,
                speed: speedSelect.value
            }));
        }

        function restoreTtsSettings() {
            const data = localStorage.getItem('ltwnc_tts_settings');
            if (!data) return;

            try {
                const settings = JSON.parse(data);
                autoplayCheckbox.checked = settings.autoplay;
                speedSelect.value = settings.speed || '1.0';

                for (let i = 0; i < voiceSelect.options.length; i++) {
                    if (voiceSelect.options[i].value === settings.voiceName) {
                        voiceSelect.selectedIndex = i;
                        break;
                    }
                }
            } catch (e) {
                console.error('Failed to restore TTS settings', e);
            }
        }

        autoplayCheckbox?.addEventListener('change', saveTtsSettings);
        voiceSelect?.addEventListener('change', saveTtsSettings);
        speedSelect?.addEventListener('change', saveTtsSettings);

        function speak(text, isVietnamese = false) {
            if (!synth || !text || text.trim() === '') return;
            if (synth.speaking) synth.cancel();

            const utterance = new SpeechSynthesisUtterance(text);
            utterance.rate = parseFloat(speedSelect?.value) || 1.0;

            if (isVietnamese) {
                const viVoice = voices.find(v => v.lang.startsWith('vi'));
                if (viVoice) utterance.voice = viVoice;
                utterance.lang = 'vi-VN';
            } else {
                const enVoice = voices.find(v => v.name === voiceSelect?.value);
                if (enVoice) utterance.voice = enVoice;
                utterance.lang = 'en-US';
            }

            synth.speak(utterance);
        }

        function statusLabel(status) {
            if (status === 2) return 'Đã thành thạo';
            if (status === 1) return 'Đang học';
            return 'Chưa học';
        }

        function sortedVocabularyCards() {
            const sort = document.getElementById('vocab-sort')?.value || 'original';
            const cards = [...vocabularyCards];
            const byOriginal = (a, b) => a.OrderIndex - b.OrderIndex;

            if (sort === 'starred') return cards.sort((a, b) => Number(b.IsStarred) - Number(a.IsStarred) || byOriginal(a, b));
            if (sort === 'unlearned') return cards.sort((a, b) => Number(a.Status !== 0) - Number(b.Status !== 0) || byOriginal(a, b));
            if (sort === 'learning') return cards.sort((a, b) => Number(a.Status !== 1) - Number(b.Status !== 1) || byOriginal(a, b));
            if (sort === 'mastered') return cards.sort((a, b) => Number(a.Status !== 2) - Number(b.Status !== 2) || byOriginal(a, b));
            return cards.sort(byOriginal);
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function renderVocabularyPanel() {
            const list = document.getElementById('vocab-list');
            if (!list) return;

            const cards = sortedVocabularyCards();
            list.innerHTML = '';

            const unlearned = cards.filter(c => c.Status !== 2);
            const mastered = cards.filter(c => c.Status === 2);

            function renderGroup(title, items, isMastered) {
                if (items.length === 0) return;

                const group = document.createElement('div');
                group.className = 'vocab-group';

                const header = document.createElement('div');
                header.className = 'vocab-group-header';
                header.innerHTML = `<h3>${title}</h3><span class="vocab-group-count">${items.length}</span>`;
                group.appendChild(header);

                const rows = document.createElement('div');
                rows.className = 'vocab-group-rows';

                items.forEach(card => {
                    const visibleIndex = cards.indexOf(card) + 1;
                    const row = document.createElement('div');
                    row.className = `vocab-row ${isMastered ? 'mastered-border' : ''}`;
                    row.innerHTML = `
                        <span class="vocab-row-index" aria-hidden="true">${visibleIndex}</span>
                        <div class="vocab-row-term">
                            <button type="button"
                                    class="vocab-star ${card.IsStarred ? 'is-starred' : ''}"
                                    aria-label="${card.IsStarred ? 'Bỏ đánh dấu sao' : 'Đánh dấu sao'} ${escapeHtml(card.FrontText || '')}"
                                    aria-pressed="${card.IsStarred}">
                                <i class="${card.IsStarred ? 'ph ph-star-fill' : 'ph ph-star'}" aria-hidden="true"></i>
                            </button>
                            <div>
                                <p class="vocab-word ${isMastered ? 'fw-bold' : ''}">${escapeHtml(card.FrontText || '')}</p>
                                <p class="vocab-meta">${escapeHtml([card.PartOfSpeech, card.Pronunciation].filter(Boolean).join(' · '))}</p>
                            </div>
                        </div>
                        <div class="vocab-row-meaning">
                            <p class="vocab-meaning">${escapeHtml(card.BackText || '')}</p>
                            <p class="vocab-example">${escapeHtml(card.ExampleSentence || '')}</p>
                        </div>
                        <button type="button" class="btn vocab-audio" aria-label="Phát giọng đọc ${escapeHtml(card.FrontText || '')}">
                            <i class="ph ph-speaker-high" aria-hidden="true"></i>
                        </button>
                    `;
                    const star = row.querySelector('.vocab-star');
                    star.addEventListener('click', () => toggleVocabularyCardStar(card));
                    const audio = row.querySelector('.vocab-audio');
                    audio.addEventListener('click', () => speak(card.FrontText || '', false));
                    rows.appendChild(row);
                });

                group.appendChild(rows);
                list.appendChild(group);
            }

            renderGroup('Chưa học', unlearned, false);
            renderGroup('Đã thành thạo', mastered, true);
        }

        function updateUI() {
            if (flashcards.length === 0) return;

            const currentCard = flashcards[currentIndex];
            enforceVisibleSide('front');
            enforceVisibleSide('back');
            syncSettingsInputs();
            // The selected language is always the prominent text; a second selected language becomes detail text.
            const frontUsesEnglish = settings.ShowFrontTerm;
            const frontTextElem = document.getElementById('card-front-text');
            frontTextElem.hidden = !settings.ShowFrontTerm && !settings.ShowFrontDefinition;
            frontTextElem.textContent = frontUsesEnglish ? currentCard.FrontText : currentCard.BackText;

            const frontBadge = document.getElementById('card-front-badge');
            frontBadge.textContent = frontUsesEnglish ? 'English' : 'Nghĩa Việt';
            frontBadge.classList.toggle('badge-blue', frontUsesEnglish);
            frontBadge.classList.toggle('badge-green', !frontUsesEnglish);

            const frontIpaElem = document.getElementById('card-front-ipa');
            frontIpaElem.hidden = !settings.ShowFrontIpa || !currentCard.Pronunciation;
            frontIpaElem.textContent = currentCard.Pronunciation || '';

            const frontDefElem = document.getElementById('card-front-definition');
            frontDefElem.hidden = !settings.ShowFrontTerm || !settings.ShowFrontDefinition;
            frontDefElem.textContent = currentCard.BackText || '';

            // Back face rendering
            const backUsesVietnamese = settings.ShowBackDefinition;
            const backDefElem = document.getElementById('card-back-text');
            backDefElem.hidden = !settings.ShowBackDefinition && !settings.ShowBackTerm;
            backDefElem.textContent = backUsesVietnamese ? currentCard.BackText : currentCard.FrontText;

            const backBadge = document.getElementById('card-back-badge');
            backBadge.textContent = backUsesVietnamese ? 'Nghĩa Việt' : 'English';
            backBadge.classList.toggle('badge-green', backUsesVietnamese);
            backBadge.classList.toggle('badge-blue', !backUsesVietnamese);

            const backTermElem = document.getElementById('card-back-term');
            backTermElem.hidden = !settings.ShowBackDefinition || !settings.ShowBackTerm;
            backTermElem.textContent = currentCard.FrontText || '';

            const backIpaElem = document.getElementById('card-back-ipa');
            backIpaElem.hidden = !settings.ShowBackIpa || !currentCard.Pronunciation;
            backIpaElem.textContent = currentCard.Pronunciation || '';

            const backExElem = document.getElementById('card-back-example');
            backExElem.hidden = !settings.ShowBackExample || !currentCard.ExampleSentence;
            if (currentCard.ExampleSentence) {
                backExElem.innerHTML = '';
                const strong = document.createElement('strong');
                strong.textContent = 'Ví dụ: ';
                backExElem.appendChild(strong);

                const textSpan = document.createElement('span');
                textSpan.textContent = currentCard.ExampleSentence;
                backExElem.appendChild(textSpan);

                if (currentCard.ExampleMeaning) {
                    backExElem.appendChild(document.createElement('br'));
                    const meaningSpan = document.createElement('span');
                    meaningSpan.className = 'text-sm text-muted';
                    meaningSpan.textContent = currentCard.ExampleMeaning;
                    backExElem.appendChild(meaningSpan);
                }
            }

            renderCardImage('front', currentCard);
            renderCardImage('back', currentCard);

            const cardCore = document.getElementById('study-card-core');
            cardCore.classList.remove('flipped');
            isFlipped = false;

            const currentDisplay = currentIndex + 1;
            const total = flashcards.length;
            document.getElementById('card-progress-text').textContent = `Thẻ ${currentDisplay} / ${total}`;
            document.getElementById('dock-progress-text').textContent = `${currentDisplay} / ${total}`;
            document.getElementById('card-progress-fill').style.transform = `scaleX(${currentDisplay / total})`;

            updateStarUI(currentCard.IsStarred);
            updateNavigationState();
            updateControlBarForFlip();
        }

        function toggleProgressMode() {
            progressMode = !progressMode;
            updateProgressModeButtons();
        }

        function handleLeftAction() {
            prevCard();
        }

        function handleRightAction() {
            nextCard();
        }

        function updateProgressModeButtons() {
            // Legacy function kept for compatibility; progress mode UI removed.
        }

        function updateNavigationState() {
            const previousButton = document.getElementById('nav-left-btn');
            const nextButton = document.getElementById('nav-right-btn');
            const nextIcon = nextButton?.querySelector('i');
            const isLastCard = currentIndex === flashcards.length - 1;

            if (previousButton) {
                previousButton.disabled = currentIndex === 0;
                previousButton.setAttribute('aria-disabled', String(previousButton.disabled));
            }

            if (nextButton) {
                nextButton.disabled = flashcards.length === 0;
                nextButton.setAttribute('aria-disabled', String(nextButton.disabled));
                nextButton.title = isLastCard ? 'Quay lại thẻ đầu' : 'Thẻ tiếp (→)';
                nextButton.setAttribute('aria-label', isLastCard ? 'Quay lại thẻ đầu' : 'Chuyển đến thẻ tiếp theo');
            }

            if (nextIcon) {
                nextIcon.className = isLastCard ? 'ph ph-arrow-clockwise' : 'ph ph-arrow-right';
            }
        }

        function updateControlBarForFlip() {
            const flipBtn = document.getElementById('flip-btn');
            const ratingGroup = document.getElementById('rating-group');
            if (!flipBtn || !ratingGroup) return;

            if (isFlipped) {
                flipBtn.hidden = true;
                ratingGroup.hidden = false;
            } else {
                flipBtn.hidden = false;
                ratingGroup.hidden = true;
            }
        }

        function toggleCurrentCardStar(event) {
            event?.stopPropagation();
            if (flashcards.length === 0) return;
            toggleCardStar(flashcards[currentIndex]);
        }

        function toggleVocabularyCardStar(card) {
            toggleCardStar(card);
        }

        function syncCardStarState(cardId, isStarred) {
            const studyCard = flashcards.find(card => card.Id === cardId);
            const vocabularyCard = vocabularyCards.find(card => card.Id === cardId);
            if (studyCard) studyCard.IsStarred = isStarred;
            if (vocabularyCard) vocabularyCard.IsStarred = isStarred;
            if (flashcards[currentIndex]?.Id === cardId) updateStarUI(isStarred);
            renderVocabularyPanel();
        }

        function toggleCardStar(card) {
            const previousState = card.IsStarred;
            const verificationToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
            syncCardStarState(card.Id, !previousState);

            const params = new URLSearchParams();
            params.append('__RequestVerificationToken', verificationToken);

            fetch(`/Study/${setId}/Flashcard/${card.Id}/ToggleStar`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: params
            })
            .then(response => {
                if (!response.ok) throw new Error('Không thể cập nhật đánh dấu sao.');
                return response.json();
            })
            .then(data => syncCardStarState(card.Id, data.isStarred))
            .catch(error => {
                console.error('AJAX Error:', error);
                syncCardStarState(card.Id, previousState);
            });
        }

        function updateStarUI(isStarred) {
            const starIconFront = document.querySelector('.card-front .card-star-btn i');
            const starIconBack = document.querySelector('.card-back .card-star-btn i');
            const starBtnFront = document.querySelector('.card-front .card-star-btn');
            const starBtnBack = document.querySelector('.card-back .card-star-btn');

            if (starIconFront && starIconBack) {
                if (isStarred) {
                    starIconFront.className = 'ph ph-star-fill';
                    starIconBack.className = 'ph ph-star-fill';
                    starBtnFront.classList.add('is-starred');
                    starBtnBack.classList.add('is-starred');
                } else {
                    starIconFront.className = 'ph ph-star';
                    starIconBack.className = 'ph ph-star';
                    starBtnFront.classList.remove('is-starred');
                    starBtnBack.classList.remove('is-starred');
                }
            }
        }

        function toggleCardFlip() {
            if (flashcards.length === 0) return;

            const cardCore = document.getElementById('study-card-core');
            isFlipped = !isFlipped;
            cardCore.classList.toggle('flipped', isFlipped);

            updateControlBarForFlip();

            if (!isFlipped) {
                if (synth) synth.cancel();
                return;
            }

            if (autoplayCheckbox?.checked) {
                speak(flashcards[currentIndex].FrontText, false);
            }
        }

        function playAudioCurrentCard() {
            if (flashcards.length === 0) return;
            const current = flashcards[currentIndex];
            speak(current.FrontText, false);
        }

        function nextCard() {
            if (flashcards.length === 0) return;

            currentIndex = (currentIndex + 1) % flashcards.length;
            updateUI();
        }

        function prevCard() {
            if (currentIndex > 0) {
                currentIndex--;
                updateUI();
            }
        }

        function shuffleCards() {
            for (let i = flashcards.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [flashcards[i], flashcards[j]] = [flashcards[j], flashcards[i]];
            }
            currentIndex = 0;
            updateUI();
        }

        function markCard(learned) {
            if (flashcards.length === 0) return;

            const card = flashcards[currentIndex];

            if (learned) {
                sessionStats.learned.add(card.Id);
                sessionStats.unlearned.delete(card.Id);
            } else {
                sessionStats.unlearned.add(card.Id);
                sessionStats.learned.delete(card.Id);
            }

            const vocabCard = vocabularyCards.find(c => c.Id === card.Id);
            if (vocabCard) {
                vocabCard.Status = learned ? 2 : 1;
                if (learned) vocabCard.CorrectCount++;
                else vocabCard.WrongCount++;
                renderVocabularyPanel();
            }

            const verificationToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const params = new URLSearchParams();
            params.append('__RequestVerificationToken', verificationToken);
            params.append('setId', setId);
            params.append('cardId', card.Id);
            params.append('learned', learned);

            fetch(`/Study/${setId}/Flashcard/Mark`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: params
            })
            .then(res => {
                if (!res.ok) console.error('Failed to save progress to server');
            })
            .catch(err => console.error('AJAX Error:', err));

            const ratedCount = sessionStats.learned.size + sessionStats.unlearned.size;
            if (ratedCount === flashcards.length) {
                showCompletionScreen();
                return;
            }

            nextCard();
        }

        function restartStudy() {
            window.location.reload();
        }

        function completeStudySession() {
            const verificationToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const params = new URLSearchParams();
            params.append('__RequestVerificationToken', verificationToken);
            params.append('setId', setId);
            params.append('sessionId', sessionId);

            fetch(`/Study/${setId}/Complete`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: params
            })
            .then(res => res.json())
            .then(data => {
                window.location.href = data.success && data.redirectUrl ? data.redirectUrl : `/Study/${setId}`;
            })
            .catch(err => {
                console.error('AJAX Error:', err);
                window.location.href = `/Study/${setId}`;
            });
        }

        function showCompletionScreen() {
            const learnedCount = sessionStats.learned.size;
            const unlearnedCount = flashcards.length - learnedCount;

            document.getElementById('count-learned').textContent = learnedCount;
            document.getElementById('count-unlearned').textContent = unlearnedCount;

            document.getElementById('study-view').style.display = 'none';
            document.getElementById('completion-view').style.display = 'grid';
        }

        document.addEventListener('keydown', function(e) {
            const settingsDrawer = document.getElementById('study-settings-drawer');
            if (e.key === 'Escape' && settingsDrawer && !settingsDrawer.hidden) {
                e.preventDefault();
                toggleSettingsDrawer();
                return;
            }

            const tagName = e.target.tagName;
            if (tagName === 'INPUT' || tagName === 'SELECT' || tagName === 'TEXTAREA' || tagName === 'BUTTON' || tagName === 'A' || e.target.isContentEditable) return;

            switch (e.key) {
                case ' ':
                    e.preventDefault();
                    toggleCardFlip();
                    break;
                case 'Backspace':
                    e.preventDefault();
                    exitStudy();
                    break;
                case 'ArrowLeft':
                    e.preventDefault();
                    prevCard();
                    break;
                case 'ArrowRight':
                    e.preventDefault();
                    nextCard();
                    break;
                case '1':
                    markCard(false);
                    break;
                case '2':
                    markCard(true);
                    break;
                case 'Control':
                    e.preventDefault();
                    playAudioCurrentCard();
                    break;
            }
        });

        document.querySelector('.flashcard-frame')?.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                toggleCardFlip();
            }
        });

        function toggleSettingsDrawer(event) {
            if (event) event.stopPropagation();
            const drawer = document.getElementById('study-settings-drawer');
            const backdrop = document.getElementById('settings-drawer-backdrop');
            const trigger = document.querySelector('.study-settings-button');
            const willOpen = drawer.hidden;

            drawer.hidden = !willOpen;
            backdrop.hidden = !willOpen;
            trigger?.setAttribute('aria-expanded', String(willOpen));
            document.body.classList.toggle('settings-open', willOpen);

            if (willOpen) {
                drawer.querySelector('.settings-drawer-body input, .settings-drawer-body select')?.focus();
            } else {
                trigger?.focus();
            }
        }

        function bindSettingsInputs() {
            document.querySelectorAll('[data-setting]').forEach(input => {
                const key = input.dataset.setting;
                const isCheckbox = input.type === 'checkbox';
                if (isCheckbox) input.checked = !!settings[key];
                else input.value = settings[key];
                input.addEventListener('change', () => {
                    settings[key] = isCheckbox ? input.checked : Number(input.value);
                    syncLanguageOrder();
                    if (key === 'StarredOnly' || key === 'UnlearnedOnly') {
                        saveSettings().finally(() => {
                            reloadWithFilters();
                        });
                        return;
                    }
                    enforceVisibleSide('front');
                    enforceVisibleSide('back');
                    saveSettings();
                    updateUI();
                });
            });

            syncLanguageOrder();

            document.addEventListener('click', (e) => {
                const drawer = document.getElementById('study-settings-drawer');
                const btn = document.querySelector('.study-settings-button');
                if (drawer && !drawer.hidden && !drawer.contains(e.target) && !btn.contains(e.target)) {
                    toggleSettingsDrawer();
                }
            });
        }

        function applyLanguageOrder(order) {
            const vietnameseFirst = order === 'vi-en';
            settings.ShowFrontTerm = !vietnameseFirst;
            settings.ShowFrontDefinition = vietnameseFirst;
            settings.ShowBackTerm = vietnameseFirst;
            settings.ShowBackDefinition = !vietnameseFirst;

            syncSettingsInputs();
            syncLanguageOrder();
            document.querySelector('.settings-advanced')?.removeAttribute('open');
            saveSettings();
            updateUI();
        }

        function syncLanguageOrder() {
            const order = settings.ShowFrontTerm && !settings.ShowFrontDefinition && !settings.ShowBackTerm && settings.ShowBackDefinition
                ? 'en-vi'
                : !settings.ShowFrontTerm && settings.ShowFrontDefinition && settings.ShowBackTerm && !settings.ShowBackDefinition
                    ? 'vi-en'
                    : null;

            document.querySelectorAll('[data-language-order]').forEach(button => {
                const isActive = button.dataset.languageOrder === order;
                button.classList.toggle('is-active', isActive);
                button.setAttribute('aria-pressed', String(isActive));
            });

            document.getElementById('settings-front-title').textContent = order === 'vi-en' ? 'Mặt trước · Tiếng Việt' : order === 'en-vi' ? 'Mặt trước · Tiếng Anh' : 'Mặt trước';
            document.getElementById('settings-back-title').textContent = order === 'vi-en' ? 'Mặt sau · Tiếng Anh' : order === 'en-vi' ? 'Mặt sau · Tiếng Việt' : 'Mặt sau';

            if (!order) document.querySelector('.settings-advanced')?.setAttribute('open', '');
        }

        function sideHasImage(side) {
            const card = flashcards[currentIndex];
            if (!card || !card.Image || settings.HideImage) return false;
            return side === 'front' ? settings.ShowFrontImage : settings.ShowBackImage;
        }

        function syncSettingsInputs() {
            document.querySelectorAll('[data-setting]').forEach(input => {
                const key = input.dataset.setting;
                if (input.type === 'checkbox') input.checked = !!settings[key];
                else input.value = settings[key];
            });
        }

        function enforceVisibleSide(side) {
            if (sideHasImage(side)) return;

            const keys = side === 'front'
                ? ['ShowFrontTerm', 'ShowFrontDefinition', 'ShowFrontIpa']
                : ['ShowBackTerm', 'ShowBackDefinition', 'ShowBackIpa', 'ShowBackExample'];

            if (keys.some(key => settings[key])) return;
            settings[keys[0]] = true;
            const input = document.querySelector(`[data-setting="${keys[0]}"]`);
            if (input) input.checked = true;
        }

        function saveSettings() {
            if (!isAuthenticated) return Promise.resolve();

            const verificationToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const params = new URLSearchParams();
            params.append('__RequestVerificationToken', verificationToken);
            Object.keys(settings).forEach(key => {
                params.append(key, settings[key]);
            });

            return fetch('/Study/Settings', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: params
            }).catch(err => console.error('Failed to save study settings', err));
        }

        function reloadWithFilters() {
            const url = new URL(window.location.href);
            url.searchParams.set('starredOnly', settings.StarredOnly);
            url.searchParams.set('unlearnedOnly', settings.UnlearnedOnly);
            url.searchParams.set('index', '0');
            window.location.href = url.toString();
        }

        function renderCardImage(side, card) {
            const image = document.getElementById(side === 'front' ? 'card-front-image' : 'card-back-image');
            const enabled = side === 'front' ? settings.ShowFrontImage : settings.ShowBackImage;

            if (!enabled || settings.HideImage || !card.Image) {
                image.hidden = true;
                image.removeAttribute('src');
                return;
            }

            image.src = card.Image;
            image.hidden = false;
            image.classList.toggle('is-large', !!settings.LargeImage);
            image.classList.toggle('is-blurred', !!settings.BlurImage);
        }

        bindSettingsInputs();
        document.getElementById('vocab-sort')?.addEventListener('change', renderVocabularyPanel);
        renderVocabularyPanel();
        updateUI();
    </script>
}
