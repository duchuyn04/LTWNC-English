@{
    // FILE: Layout chính toàn site (trừ Auth/Admin/404 standalone).
    // @inject ICreditService — đọc số dư hiện trên nav (user đã login).
    // ViewData HideLayoutChrome: ẩn top nav/footer cho Study/Review fullscreen.
    // Sections: Styles, Scripts, FullWidth (nội dung full-bleed).
    // Menu: Study sets, Library, Credits, Profile, Admin nếu claim IsAdmin=true.
    // TempData SuccessMessage/ErrorMessage → data-popup global.
    // Logout: form POST Account/Logout + antiforgery.
    // CSS/JS global: site.css, Bootstrap, Phosphor icons, popup helper.
}
@inject ltwnc.Services.Credits.ICreditService CreditService
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LTWNC English</title>
    <meta name="description" content="LTWNC English giúp bạn học từ vựng bằng flashcard, nghe chép, hội thoại tình huống và theo dõi tiến độ." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/phosphor-icons@1.4.2/src/css/icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/popup.css" asp-append-version="true" />
</head>
<body>
    @{
        // --- Biến layout dùng xuyên suốt nav/footer ---
        // HideLayoutChrome: Study/Review/Mission fullscreen không vẽ header/footer.
        var hideLayoutChrome = ViewData["HideLayoutChrome"] as bool? == true;
        var signedIn = User.Identity?.IsAuthenticated == true;
        var currentPath = Context.Request.Path.Value ?? "/";
        int? creditBalance = null;
        // Claim NameIdentifier = AppUser.Id (cookie auth tự quản).
        string? layoutUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        // Chỉ query số dư khi có nav (tránh tốn DB trên màn fullscreen).
        if (signedIn && !hideLayoutChrome && layoutUserId != null)
        {
            creditBalance = await CreditService.GetBalanceAsync(layoutUserId);
        }
    }
    @if (!hideLayoutChrome)
    {
    <header class="app-header">
        <nav class="app-nav" aria-label="Điều hướng chính">
            <div class="container app-nav-shell">
                <a class="app-nav-brand" href="/" aria-label="LTWNC - Trang chủ">
                    <span class="app-nav-brand-mark" aria-hidden="true">
                        <i class="ph ph-book-open"></i>
                    </span>
                    <span>LTWNC</span>
                </a>

                <div class="app-nav-actions">
                    @if (signedIn)
                    {
                        <a class="app-nav-credit" href="/Credits" aria-label="@creditBalance tín dụng AI">
                            <i class="ph ph-lightning" aria-hidden="true"></i>
                            <span>@creditBalance</span>
                        </a>
                        <a class="app-nav-account"
                           asp-route="PublicProfile"
                           asp-route-username="@User.Identity?.Name"
                           aria-label="Mở hồ sơ @User.Identity?.Name">
                            <i class="ph ph-user-circle" aria-hidden="true"></i>
                            <span>@User.Identity?.Name</span>
                        </a>
                    }
                    else
                    {
                        <a class="app-nav-login" href="/Account/Login">Đăng nhập</a>
                    }

                    <button class="app-nav-menu" type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#appNavigation"
                            aria-controls="appNavigation"
                            aria-label="Mở menu điều hướng">
                        <span>Menu</span>
                        <i class="ph ph-list" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </nav>

        <aside class="offcanvas offcanvas-end app-nav-drawer" tabindex="-1"
               id="appNavigation" aria-labelledby="appNavigationTitle">
            <div class="offcanvas-header app-drawer-header">
                <div>
                    <span class="app-drawer-context">LTWNC English</span>
                    <h2 class="offcanvas-title" id="appNavigationTitle">Bạn muốn đi đâu?</h2>
                </div>
                <button type="button" class="app-drawer-close" data-bs-dismiss="offcanvas" aria-label="Đóng menu">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            </div>

            <div class="offcanvas-body app-drawer-body">
                <nav class="app-drawer-nav" aria-label="Các khu vực trong ứng dụng">
                    <a class="app-drawer-link @(currentPath == "/" ? "is-active" : null)" href="/">
                        <i class="ph ph-house" aria-hidden="true"></i>
                        <span>Trang chủ</span>
                    </a>
                    <a class="app-drawer-link @(currentPath.StartsWith("/Library") ? "is-active" : null)" href="/Library">
                        <i class="ph ph-books" aria-hidden="true"></i>
                        <span>Thư viện</span>
                    </a>
                    <a class="app-drawer-link @(currentPath.StartsWith("/Leaderboard") ? "is-active" : null)" href="/Leaderboard">
                        <i class="ph ph-trophy" aria-hidden="true"></i>
                        <span>Bảng xếp hạng</span>
                    </a>
                    @if (signedIn)
                    {
                        <a class="app-drawer-link @(currentPath.StartsWith("/Set") || currentPath.StartsWith("/Study") ? "is-active" : null)" href="/Set">
                            <i class="ph ph-stack" aria-hidden="true"></i>
                            <span>Bộ thẻ của tôi</span>
                        </a>
                        <a class="app-drawer-link @(currentPath.StartsWith("/Review") ? "is-active" : null)" href="/Review">
                            <i class="ph ph-timer" aria-hidden="true"></i>
                            <span>Ôn tập đến hạn</span>
                        </a>
                        <a class="app-drawer-link @(currentPath.StartsWith("/Achievements") ? "is-active" : null)" href="/Achievements">
                            <i class="ph ph-medal" aria-hidden="true"></i>
                            <span>Thành tích</span>
                        </a>
                        <a class="app-drawer-link @(currentPath.StartsWith("/Credits") ? "is-active" : null)" href="/Credits">
                            <i class="ph ph-lightning" aria-hidden="true"></i>
                            <span>Tín dụng AI (@creditBalance)</span>
                        </a>
                    }
                </nav>

                <div class="app-drawer-divider"></div>

                @if (signedIn)
                {
                    <section class="app-drawer-account" aria-labelledby="drawerAccountTitle">
                        <h3 id="drawerAccountTitle">Tài khoản</h3>
                        <a asp-route="PublicProfile" asp-route-username="@User.Identity?.Name">
                            <i class="ph ph-user" aria-hidden="true"></i>
                            Xem hồ sơ
                        </a>
                        <a href="/Account/Profile/Edit">
                            <i class="ph ph-pencil-simple" aria-hidden="true"></i>
                            Chỉnh sửa hồ sơ
                        </a>
                        @if (User.HasClaim(ltwnc.Services.Auth.AppClaimTypes.IsAdmin, "true"))
                        {
                            <a href="/Admin">
                                <i class="ph ph-gear-six" aria-hidden="true"></i>
                                Quản trị
                            </a>
                        }
                    </section>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="app-drawer-logout">
                        <button type="submit">
                            <span>Đăng xuất</span>
                            <i class="ph ph-sign-out" aria-hidden="true"></i>
                        </button>
                    </form>
                }
                else
                {
                    <div class="app-drawer-guest">
                        <p>Lưu tiến độ học và xây dựng thư viện từ vựng của riêng bạn.</p>
                        <a class="app-drawer-register" href="/Account/Register">Tạo tài khoản</a>
                    </div>
                }
            </div>
        </aside>
    </header>
    }

    <main class="app-main">
        @if (TempData["SuccessMessage"] is string globalSuccessMessage)
        {
            <div data-popup="success">@globalSuccessMessage</div>
        }
        @if (TempData["ErrorMessage"] is string globalErrorMessage)
        {
            <div data-popup="error">@globalErrorMessage</div>
        }
        @if (IsSectionDefined("FullWidth"))
        {
            @RenderSection("FullWidth", required: false)
        }
        else
        {
            <div class="container py-5">
                @RenderBody()
            </div>
        }
    </main>

    @if (!hideLayoutChrome)
    {
    <footer class="app-footer">
        <div class="container app-footer-inner">
            <div class="app-footer-main">
                <div class="app-footer-intro">
                    <a class="app-footer-brand" href="/" aria-label="LTWNC English - Trang chủ">
                        <span class="app-footer-brand-mark"><i class="ph ph-book-open" aria-hidden="true"></i></span>
                        <span>LTWNC <small>English</small></span>
                    </a>
                    <p class="app-footer-tagline">Biến từ mới thành vốn từ bạn thực sự sử dụng, qua những buổi học ngắn và đều đặn.</p>
                    <a class="app-footer-cta" href="@(signedIn ? "/Set/Create" : "/Account/Register")">
                        @(signedIn ? "Tạo bộ thẻ mới" : "Bắt đầu học miễn phí")
                        <i class="ph ph-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>

                <div class="app-footer-navs">
                    <nav aria-label="Khám phá">
                        <div class="app-footer-heading">Khám phá</div>
                        <ul class="app-footer-links">
                            <li><a href="/Library">Thư viện bộ từ</a></li>
                            <li><a href="/Leaderboard">Bảng xếp hạng</a></li>
                            <li><a href="/#services">Phương pháp học</a></li>
                        </ul>
                    </nav>
                    <nav aria-label="Tài khoản">
                        <div class="app-footer-heading">Tài khoản</div>
                        <ul class="app-footer-links">
                            @if (signedIn)
                            {
                                <li><a href="/Set">Bộ thẻ của tôi</a></li>
                                <li><a href="/Achievements">Thành tích</a></li>
                                <li><a href="/Account/Profile/Edit">Chỉnh sửa hồ sơ</a></li>
                            }
                            else
                            {
                                <li><a href="/Account/Login">Đăng nhập</a></li>
                                <li><a href="/Account/Register">Tạo tài khoản</a></li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
            <div class="app-footer-bottom">
                <span>&copy; @DateTime.Now.Year LTWNC English</span>
                <span class="app-footer-signature">Flashcard <i aria-hidden="true"></i> Nghe chép <i aria-hidden="true"></i> Hội thoại AI</span>
                <a asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
            </div>
        </div>
    </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
