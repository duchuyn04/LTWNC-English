@model SetDetailViewModel
@using ltwnc.Areas.Admin
@{
    // FILE: Chi tiết 1 bộ thẻ — FlashcardSetController.Details (owner hoặc public active).
    // Model: SetDetailViewModel (meta, cards preview, quyền, moderation quarantine).
    // Owner: Edit, Study hub, Review, delete/copy; Guest: copy public nếu IsPublic & Active.
    // ModerationStatus Quarantined: ẩn public library, owner thấy lý do public reason.
    // CSS set-management.css.
    ViewData["Title"] = Model.Title;
}

<link rel="stylesheet" href="~/css/set-management.css" asp-append-version="true" />

<div class="set-management-shell">
    <div class="set-detail-hero">
        <h2>@Model.Title</h2>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p>@Model.Description</p>
        }
        else
        {
            <p>@(Model.IsPublic ? "Bộ thẻ công khai" : "Bộ thẻ riêng tư") · @Model.Flashcards.Count thẻ</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AuthorUsername))
        {
            <a class="set-detail-author-link"
               asp-route="PublicProfile"
               asp-route-username="@Model.AuthorUsername"
               aria-label="Xem profile của @Model.AuthorUsername">
                <span class="set-detail-author-avatar" aria-hidden="true">@Model.AuthorInitials</span>
                <span>
                    <small>Chia sẻ bởi</small>
                    <strong>@Model.AuthorUsername</strong>
                </span>
            </a>
        }
        else
        {
            <div class="set-detail-author-fallback">Tác giả không còn khả dụng</div>
        }

        <div class="set-detail-stats">
            <div class="set-detail-stat">
                <div class="set-detail-stat-value">0%</div>
                <div class="set-detail-stat-label">Tiến độ</div>
            </div>
            <div class="set-detail-stat">
                <div class="set-detail-stat-value">0</div>
                <div class="set-detail-stat-label">Đã thuộc</div>
            </div>
            <div class="set-detail-stat">
                <div class="set-detail-stat-value">@Model.Flashcards.Count</div>
                <div class="set-detail-stat-label">Tổng số</div>
            </div>
        </div>

        @if (Model.IsOwner && Model.IsQuarantined)
        {
            <div class="set-report-alert set-report-alert--danger" role="alert">
                Bộ flashcard này đang bị cách ly khỏi tìm kiếm, chia sẻ, sao chép và học công khai.
                @if (!string.IsNullOrWhiteSpace(Model.ModerationPublicReason))
                {
                    <span>Lý do: @Model.ModerationPublicReason</span>
                }
                @if (Model.ModeratedAtUtc.HasValue)
                {
                    <span>Thời điểm xử lý: @FormatVietnamTime(Model.ModeratedAtUtc.Value)</span>
                }
            </div>
        }

        <div class="d-flex gap-2 justify-content-center flex-wrap">
            @if (Model.IsOwner)
            {
                <a href="/Set/@Model.Id/Edit" class="btn-secondary-custom">
                    <i class="ph ph-pencil"></i> Quản lý
                </a>
                @if (!Model.IsQuarantined)
                {
                    <form asp-action="Duplicate"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline"
                          data-confirm="Tạo một bản sao riêng tư và độc lập của bộ thẻ này?">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-secondary-custom">
                            <i class="ph ph-copy"></i> Nhân bản
                        </button>
                    </form>
                }
                <a href="/Study/@Model.Id/Flashcard" class="btn-primary-custom">
                    <i class="ph ph-play-circle"></i> Bắt đầu học
                </a>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                if (Model.ExistingCopyId.HasValue)
                {
                    <a href="/Study/@Model.ExistingCopyId/Flashcard" class="btn-primary-custom">
                        <i class="ph ph-play-circle"></i> Mở bộ đã sao chép
                    </a>
                }
                else
                {
                    <form asp-action="Copy" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-primary-custom">
                            <i class="ph ph-copy"></i> Sao chép và học
                        </button>
                    </form>
                }
            }
            else
            {
                <a href="/Account/Login?ReturnUrl=@Uri.EscapeDataString($"/Set/{Model.Id}")" class="btn-primary-custom">
                    <i class="ph ph-sign-in"></i> Đăng nhập để học
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="set-report-alert set-report-alert--success" data-popup="success">@success</div>
    }

    @if (TempData["DuplicateError"] is string duplicateError)
    {
        <div class="set-report-alert set-report-alert--danger" data-popup="error">@duplicateError</div>
    }

    @if (TempData["ContentReportSuccess"] is string reportSuccess)
    {
        <div class="set-report-alert set-report-alert--success" data-popup="success">@reportSuccess</div>
    }

    @if (TempData["ContentReportError"] is string reportError)
    {
        <div class="set-report-alert set-report-alert--danger" data-popup="error">@reportError</div>
    }

    @if (Model.CanReport)
    {
        <div class="set-report-trigger-row">
            <button type="button"
                    class="set-report-trigger btn-secondary-custom"
                    data-bs-toggle="modal"
                    data-bs-target="#report-content-modal"
                    aria-haspopup="dialog">
                <i class="ph ph-flag" aria-hidden="true"></i> Báo cáo bộ thẻ
            </button>
        </div>

        <div class="modal fade set-report-modal"
             id="report-content-modal"
             tabindex="-1"
             aria-labelledby="report-content-heading"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <span class="set-report-modal-kicker">Phản hồi nội dung</span>
                            <h3 id="report-content-heading">Báo cáo bộ flashcard</h3>
                            <p>Chọn lý do và thêm mô tả nếu cần.</p>
                        </div>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Đóng popup báo cáo"></button>
                    </div>
                    <div class="modal-body">
                        <form asp-action="Report"
                              asp-route-id="@Model.Id"
                              method="post"
                              class="set-report-form">
                            @Html.AntiForgeryToken()
                            <div>
                                <label for="report-reason">Lý do</label>
                                <select id="report-reason" name="Reason" required>
                                    <option value="">Chọn lý do</option>
                                    @foreach (var option in Model.ReportReasonOptions)
                                    {
                                        <option value="@option.Value">@option.Label</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label for="report-description">Mô tả thêm</label>
                                <textarea id="report-description"
                                          name="Description"
                                          maxlength="1000"
                                          rows="4"></textarea>
                            </div>
                            <div class="set-report-form-actions">
                                <button type="button"
                                        class="btn-secondary-custom"
                                        data-bs-dismiss="modal">
                                    Hủy
                                </button>
                                <button type="submit" class="btn-primary-custom">
                                    <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
                                    Gửi báo cáo
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.HasOpenReport)
    {
        <div class="set-report-alert" role="status">
            Bạn đã có một báo cáo đang chờ xử lý cho bộ flashcard này.
        </div>
    }

    @if (Model.Flashcards.Any())
    {
        <div class="set-detail-list">
            <div class="set-detail-list-header">
                <h3>Nội dung bộ thẻ</h3>
                @if (Model.IsOwner)
                {
                    <a href="/Set/@Model.Id/Edit" class="btn-secondary-custom set-detail-list-action">Quản lý</a>
                }
            </div>

            <div class="set-detail-card-list">
                @{ int cardNumber = 1; }
                @foreach (var card in Model.Flashcards.OrderBy(card => card.OrderIndex))
                {
                    string? imageSource = null;
                    if (!string.IsNullOrWhiteSpace(card.UploadedImagePath))
                    {
                        imageSource = card.UploadedImagePath;
                    }
                    else if (!string.IsNullOrWhiteSpace(card.ImageUrl))
                    {
                        imageSource = card.ImageUrl;
                    }

                    <article class="set-detail-card" aria-labelledby="set-card-@card.Id">
                        <div class="set-detail-card-number">Thẻ @cardNumber</div>
                        <div class="set-detail-card-sides">
                            <section class="set-detail-side set-detail-side-front">
                                <span class="set-detail-side-label">Mặt trước</span>
                                <h4 id="set-card-@card.Id">@card.FrontText</h4>
                                @if (!string.IsNullOrWhiteSpace(card.Pronunciation) ||
                                     !string.IsNullOrWhiteSpace(card.PartOfSpeech))
                                {
                                    <div class="set-detail-card-meta">
                                        @if (!string.IsNullOrWhiteSpace(card.Pronunciation))
                                        {
                                            <span>Phát âm: @card.Pronunciation</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(card.PartOfSpeech))
                                        {
                                            <span>Loại từ: @card.PartOfSpeech</span>
                                        }
                                    </div>
                                }
                            </section>

                            <section class="set-detail-side set-detail-side-back">
                                <span class="set-detail-side-label">Mặt sau</span>
                                <p class="set-detail-definition">@card.BackText</p>
                            </section>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(card.ExampleSentence))
                        {
                            <div class="set-detail-example">
                                <span>Câu ví dụ</span>
                                <p>@card.ExampleSentence</p>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(card.ExampleMeaning))
                        {
                            <div class="set-detail-example">
                                <span>Nghĩa câu ví dụ</span>
                                <p>@card.ExampleMeaning</p>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(card.Synonyms))
                        {
                            <div class="set-detail-card-meta set-detail-card-meta-wide">
                                <span>Từ đồng nghĩa: @card.Synonyms</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(imageSource))
                        {
                            <img class="set-detail-card-image"
                                 src="@imageSource"
                                 alt="Ảnh minh họa cho @card.FrontText" />
                        }
                    </article>

                    cardNumber++;
                }
            </div>
        </div>
    }
    else
    {
        <div class="set-empty-state">
            <div class="set-empty-state-icon"><i class="ph ph-note-pencil" aria-hidden="true"></i></div>
            <p class="set-empty-state-title">Bộ thẻ này chưa có từ nào.</p>
            @if (Model.IsOwner)
            {
                <a href="/Set/@Model.Id/Edit" class="btn-primary-custom">Thêm từ đầu tiên</a>
            }
        </div>
    }
</div>

@functions {
    private static string FormatVietnamTime(DateTime valueUtc)
    {
        return AdminTimeZone.ToVietnamTime(valueUtc).ToString("HH:mm dd/MM/yyyy");
    }
}
