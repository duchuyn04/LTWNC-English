@model LessonPracticeResultViewModel
@{
    ViewData["Title"] = "Kết quả ôn tập";
}

<link rel="stylesheet" href="~/css/lessons.css" asp-append-version="true" />

<div class="ls-page ls-prac">
    <a class="ls-back" href="/Lessons/@Model.LessonId">
        <i class="ph ph-arrow-left" aria-hidden="true"></i>
        Về bài học
    </a>

    <div class="ls-prac-result">
        <p class="ls-eyebrow">Hoàn thành</p>
        <h1>@Model.LessonTitle</h1>
        <div class="ls-prac-score">@Model.Score/@Model.Total</div>
        <p>Số câu trả lời đúng.</p>
        <div class="ls-actions" style="justify-content:center;border:0;padding:0;margin-top:1.5rem">
            <a class="btn-primary-custom" href="/Lessons/@Model.LessonId/Practice?restart=true">Làm lại</a>
            <a class="btn-secondary-custom" href="/Lessons/@Model.LessonId">Về bài học</a>
        </div>
    </div>
</div>
