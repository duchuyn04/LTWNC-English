@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-form-card" aria-labelledby="forgot-title">
    <p class="auth-eyebrow">Khôi phục quyền truy cập</p>
    <h1 id="forgot-title" class="auth-title">Quên mật khẩu?</h1>
    <p class="auth-intro">Nhập email đã đăng ký. Nếu email hợp lệ, bạn sẽ nhận được mã OTP để đặt mật khẩu mới.</p>

    <form asp-action="ForgotPassword" method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>
        <div class="auth-field">
            <label asp-for="Email" class="auth-label"></label>
            <input asp-for="Email"
                   class="auth-input"
                   placeholder="Nhập email đã đăng ký"
                   autocomplete="email"
                   autofocus />
            <span asp-validation-for="Email"></span>
        </div>
        <button type="submit" class="auth-submit">Gửi mã OTP <span aria-hidden="true">→</span></button>
    </form>

    <p class="auth-alt"><a href="/Account/Login">Quay lại đăng nhập</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
