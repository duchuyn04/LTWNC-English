@model ResetPasswordViewModel
@{
    // FILE: Đặt mật khẩu mới bằng OTP — AccountController.ResetPassword.
    // Model: ResetPasswordViewModel (ChallengeId, Code, NewPassword, Confirm).
    // Thành công: hash password mới + rotate SecurityStamp → mọi cookie cũ bị invalidate (OnValidatePrincipal).
    // PasswordPolicy kiểm tra độ mạnh phía server (và validation attributes phía client).
    // data-password-toggle cho NewPassword.
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="auth-form-card" aria-labelledby="reset-title">
    <p class="auth-eyebrow">Khôi phục quyền truy cập</p>
    <h1 id="reset-title" class="auth-title">Đặt mật khẩu mới.</h1>
    <p class="auth-intro">Nhập mã OTP trong email và tạo mật khẩu mới cho tài khoản của bạn.</p>

    <form asp-action="ResetPassword" method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>
        <input asp-for="ChallengeId" type="hidden" />

        <div class="auth-field">
            <label asp-for="Code" class="auth-label"></label>
            <input asp-for="Code"
                   class="auth-input"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   maxlength="6"
                   placeholder="000000"
                   autofocus />
            <span asp-validation-for="Code"></span>
        </div>

        <div class="auth-field">
            <label asp-for="NewPassword" class="auth-label"></label>
            <span class="auth-password">
                <input asp-for="NewPassword"
                       class="auth-input"
                       autocomplete="new-password"
                       aria-describedby="NewPassword-hint" />
                <button class="auth-password__toggle" type="button" data-password-toggle aria-controls="NewPassword" aria-label="Hiện mật khẩu">Hiện</button>
            </span>
            <small id="NewPassword-hint" class="auth-hint">Tối thiểu 8 ký tự, có chữ hoa, chữ thường và số.</small>
            <span asp-validation-for="NewPassword"></span>
        </div>

        <div class="auth-field">
            <label asp-for="ConfirmPassword" class="auth-label"></label>
            <span class="auth-password">
                <input asp-for="ConfirmPassword" class="auth-input" autocomplete="new-password" />
                <button class="auth-password__toggle" type="button" data-password-toggle aria-controls="ConfirmPassword" aria-label="Hiện mật khẩu xác nhận">Hiện</button>
            </span>
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="auth-submit">Đặt lại mật khẩu <span aria-hidden="true">→</span></button>
    </form>

    <form asp-action="ResendPasswordResetOtp" method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <input name="challengeId" value="@Model.ChallengeId" type="hidden" />
        <button type="submit" class="auth-submit auth-submit-secondary">Gửi lại mã (sau 1 phút)</button>
    </form>
    <p class="auth-alt"><a href="/Account/ForgotPassword">Nhập email khác</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
