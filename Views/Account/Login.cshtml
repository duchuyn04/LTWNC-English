@model LoginViewModel
@{
    // FILE: Đăng nhập — AccountController.Login (GET hiển thị / POST xử lý).
    // Model: LoginViewModel (UserName, Password, RememberMe nếu có).
    // Luồng: form POST → AuthService cookie auth → redirect returnUrl hoặc Home.
    // Google: nếu ViewData["GoogleLoginEnabled"] thì hiện link GoogleLogin (OAuth external cookie).
    // Layout: _AuthLayout (UI auth riêng, không nav app đầy đủ).
    // Kỹ thuật: Tag Helpers form (antiforgery token tự chèn), TempData Error/Success, validation unobtrusive.
    // JS: data-password-toggle hiện/ẩn mật khẩu; section Scripts nạp _ValidationScriptsPartial.
    // Bảo mật: rate-limit policy "auth" ở controller; không log password.
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-form-card" aria-labelledby="login-title">

    <p class="auth-eyebrow">Tài khoản</p>
    <h1 id="login-title" class="auth-title">Đăng nhập</h1>
    <p class="auth-intro">Nhập thông tin tài khoản để tiếp tục.</p>

    @if (TempData["Error"] is string error)
    {
        <div class="auth-validation-summary" role="alert">@error</div>
    }
    @if (TempData["Success"] is string success)
    {
        <div class="auth-success" role="status">@success</div>
    }

    @if ((bool?)ViewData["GoogleLoginEnabled"] == true)
    {
        <a class="auth-submit auth-google-submit" href="@Url.Action("GoogleLogin", "Account")">
            <svg class="auth-google-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="#4285F4" d="M21.35 12.27c0-.79-.07-1.54-.22-2.27H12v4.3h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.15c1.84-1.7 2.9-4.2 2.9-7.42Z" />
                <path fill="#34A853" d="M12 21.75c2.63 0 4.84-.87 6.45-2.36l-3.15-2.45c-.87.58-1.98.92-3.3.92-2.54 0-4.7-1.72-5.47-4.03H3.27v2.53A9.75 9.75 0 0 0 12 21.75Z" />
                <path fill="#FBBC05" d="M6.53 13.83a5.86 5.86 0 0 1 0-3.66V7.64H3.27a9.75 9.75 0 0 0 0 8.72l3.26-2.53Z" />
                <path fill="#EA4335" d="M12 6.14c1.43 0 2.71.49 3.72 1.45l2.78-2.78C16.84 3.23 14.63 2.25 12 2.25a9.75 9.75 0 0 0-8.73 5.39l3.26 2.53C7.3 7.86 9.46 6.14 12 6.14Z" />
            </svg>
            <span>Đăng nhập bằng Google</span>
        </a>
        <div class="auth-divider"><span>Hoặc đăng nhập bằng tài khoản</span></div>
    }

    <form asp-action="Login" method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>

        <div class="auth-field">
            <label asp-for="Username" class="auth-label"></label>
            <input asp-for="Username"
                   class="auth-input"
                   placeholder="Nhập tên đăng nhập"
                   autocomplete="username"
                   aria-describedby="Username-error"
                   autofocus />
            <span asp-validation-for="Username" id="Username-error"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Password" class="auth-label"></label>
            <span class="auth-password">
                <input asp-for="Password"
                       class="auth-input"
                       placeholder="Nhập mật khẩu"
                       autocomplete="current-password"
                       aria-describedby="Password-error" />
                <button class="auth-password__toggle"
                        type="button"
                        data-password-toggle
                        aria-controls="Password"
                        aria-label="Hiện mật khẩu">Hiện</button>
            </span>
            <span asp-validation-for="Password" id="Password-error"></span>
        </div>

        <label class="auth-check">
            <input asp-for="RememberMe" />
            <span>Duy trì đăng nhập trên thiết bị này</span>
        </label>

        <button type="submit" class="auth-submit">Đăng nhập</button>
    </form>

    <p class="auth-alt"><a href="/Account/ForgotPassword">Quên mật khẩu?</a></p>
    <p class="auth-alt">Chưa có tài khoản? <a href="/Account/Register">Đăng ký</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
