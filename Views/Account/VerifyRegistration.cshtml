@model VerifyRegistrationViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Xác thực email";
}

<section class="auth-form-card" aria-labelledby="verify-title">
    <p class="auth-eyebrow">Bước cuối cùng</p>
    <h1 id="verify-title" class="auth-title">Kiểm tra email.</h1>
    <p class="auth-intro">Nhập mã OTP 6 số đã được gửi tới email của bạn. Mã có hiệu lực trong 5 phút.</p>

    <form asp-action="VerifyRegistration" method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>
        <input asp-for="ChallengeId" type="hidden" />
        <div class="auth-field">
            <label asp-for="Code" class="auth-label"></label>
            <input asp-for="Code"
                   class="auth-input"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   maxlength="6"
                   placeholder="000000"
                   autofocus />
            <span asp-validation-for="Code"></span>
        </div>
        <button type="submit" class="auth-submit">Xác thực email <span aria-hidden="true">→</span></button>
    </form>

    <form asp-action="ResendRegistrationOtp" method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <input name="challengeId" value="@Model.ChallengeId" type="hidden" />
        <button type="submit" class="auth-submit auth-submit-secondary">Gửi lại mã (sau 1 phút)</button>
    </form>
    <p class="auth-alt"><a href="/Account/Register">Quay lại đăng ký</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
