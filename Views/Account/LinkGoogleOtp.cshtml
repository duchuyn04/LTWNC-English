@model GoogleLinkOtpViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Xác nhận liên kết Google";
}

<section class="auth-form-card" aria-labelledby="link-google-otp-title">
    <p class="auth-eyebrow">Xác nhận bảo mật</p>
    <h1 id="link-google-otp-title" class="auth-title">Nhập mã OTP.</h1>
    <p class="auth-intro">Mã đã được gửi tới email đang liên kết với tài khoản local của bạn.</p>

    <form asp-action="LinkGoogleOtp" method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>
        <input asp-for="ChallengeId" type="hidden" />
        <div class="auth-field">
            <label asp-for="Code" class="auth-label"></label>
            <input asp-for="Code" class="auth-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" autofocus />
            <span asp-validation-for="Code"></span>
        </div>
        <button type="submit" class="auth-submit">Xác nhận liên kết <span aria-hidden="true">→</span></button>
    </form>

    <form asp-action="ResendGoogleLinkOtp" method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <input name="challengeId" value="@Model.ChallengeId" type="hidden" />
        <button type="submit" class="auth-submit auth-submit-secondary">Gửi lại mã (sau 1 phút)</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
