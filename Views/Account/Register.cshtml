@model RegisterViewModel
@{
    // FILE: Đăng ký local — AccountController.Register.
    // Model: RegisterViewModel (Email, UserName, Password, Confirm...).
    // Luồng: POST lưu PendingRegistration → gửi OTP email → VerifyRegistration → tạo AppUser.
    // Có thể đăng ký bằng Google (cùng OAuth flow, tạo user nếu email mới).
    // Layout _AuthLayout; Tag Helpers + client validation.
    // Sau OTP đúng: auto sign-in cookie, credit welcome bonus (backend).
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng ký";
}

<section class="auth-form-card" aria-labelledby="register-title">

    <p class="auth-eyebrow">Tài khoản mới</p>
    <h1 id="register-title" class="auth-title">Tạo tài khoản</h1>
    <p class="auth-intro">Điền thông tin bên dưới. Mã xác thực sẽ được gửi đến email của bạn.</p>

    @if ((bool?)ViewData["GoogleLoginEnabled"] == true)
    {
        <a class="auth-submit auth-google-submit" href="@Url.Action("GoogleLogin", "Account")">
            <svg class="auth-google-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="#4285F4" d="M21.35 12.27c0-.79-.07-1.54-.22-2.27H12v4.3h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.15c1.84-1.7 2.9-4.2 2.9-7.42Z" />
                <path fill="#34A853" d="M12 21.75c2.63 0 4.84-.87 6.45-2.36l-3.15-2.45c-.87.58-1.98.92-3.3.92-2.54 0-4.7-1.72-5.47-4.03H3.27v2.53A9.75 9.75 0 0 0 12 21.75Z" />
                <path fill="#FBBC05" d="M6.53 13.83a5.86 5.86 0 0 1 0-3.66V7.64H3.27a9.75 9.75 0 0 0 0 8.72l3.26-2.53Z" />
                <path fill="#EA4335" d="M12 6.14c1.43 0 2.71.49 3.72 1.45l2.78-2.78C16.84 3.23 14.63 2.25 12 2.25a9.75 9.75 0 0 0-8.73 5.39l3.26 2.53C7.3 7.86 9.46 6.14 12 6.14Z" />
            </svg>
            <span>Đăng ký bằng Google</span>
        </a>
        <div class="auth-divider"><span>Hoặc đăng ký bằng email</span></div>
    }

    <form asp-action="Register" method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>

        <div class="auth-field-grid">
            <div class="auth-field">
                <label asp-for="Email" class="auth-label"></label>
                <input asp-for="Email"
                       class="auth-input"
                       placeholder="Nhập email của bạn"
                       autocomplete="email"
                       aria-describedby="Email-error"
                       autofocus />
                <span asp-validation-for="Email" id="Email-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Username" class="auth-label"></label>
                <input asp-for="Username"
                       class="auth-input"
                       placeholder="Chọn tên đăng nhập"
                       autocomplete="username"
                       aria-describedby="Username-error" />
                <span asp-validation-for="Username" id="Username-error"></span>
            </div>
        </div>

        <div class="auth-field">
            <label asp-for="Password" class="auth-label"></label>
            <span class="auth-password">
                <input asp-for="Password"
                       class="auth-input"
                       placeholder="Tạo mật khẩu"
                       autocomplete="new-password"
                       aria-describedby="Password-hint Password-error" />
                <button class="auth-password__toggle"
                        type="button"
                        data-password-toggle
                        aria-controls="Password"
                        aria-label="Hiện mật khẩu">Hiện</button>
            </span>
            <small id="Password-hint" class="auth-hint">Mật khẩu tối thiểu 8 ký tự, có chữ hoa, chữ thường và số.</small>
            <span asp-validation-for="Password" id="Password-error"></span>
        </div>

        <div class="auth-field">
            <label asp-for="ConfirmPassword" class="auth-label"></label>
            <span class="auth-password">
                <input asp-for="ConfirmPassword"
                       class="auth-input"
                       placeholder="Xác nhận mật khẩu"
                       autocomplete="new-password"
                       aria-describedby="ConfirmPassword-error" />
                <button class="auth-password__toggle"
                        type="button"
                        data-password-toggle
                        aria-controls="ConfirmPassword"
                        aria-label="Hiện mật khẩu xác nhận">Hiện</button>
            </span>
            <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error"></span>
        </div>

        <button type="submit" class="auth-submit">Gửi mã xác thực</button>
    </form>

    <p class="auth-alt">Đã có tài khoản? <a href="/Account/Login">Đăng nhập</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
