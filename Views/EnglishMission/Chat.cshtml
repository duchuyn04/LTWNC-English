@model ltwnc.Models.ViewModels.EnglishMission.EnglishMissionChatViewModel
@{
    ViewData["Title"] = Model.Mission.Title;
    ViewData["HideLayoutChrome"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/english-mission.css" asp-append-version="true" />
}

<div class="mission-chat-page"
     data-set-id="@Model.SetId"
     data-session-id="@Model.Mission.StudySessionId"
     data-npc-name="@Model.Mission.NpcName"
     data-opening-line="@Model.Mission.OpeningLine"
     data-max-turns="8"
     aria-busy="false">
    @Html.AntiForgeryToken()
    @if (TempData["MissionError"] is string error)
    {
        <div class="mission-alert mission-chat-alert" role="alert">
            <i class="ph ph-warning-circle" aria-hidden="true"></i>
            <span>@error</span>
        </div>
    }
    <aside class="mission-rail">
        <a class="mission-rail-brand" href="/Study/@Model.SetId" aria-label="Rời mission và quay lại Study Hub"><i class="ph ph-arrow-left" aria-hidden="true"></i><span>ENGLISH<br>MISSION</span></a>
        <div class="mission-rail-progress">
            <span class="mission-label">Tiến độ</span>
            <strong><span id="mission-turn-count" aria-live="polite">@Model.Mission.TurnCount</span> <small>/ 8 lượt</small></strong>
            <div class="mission-progress"
                 data-mission-progress
                 role="progressbar"
                 aria-label="Tiến độ lượt hội thoại"
                 aria-valuemin="0"
                 aria-valuemax="8"
                 aria-valuenow="@Model.Mission.TurnCount">
                <span data-mission-progress-bar
                      style="width:@(Model.Mission.TurnCount * 100 / 8)%"></span>
            </div>
        </div>
        <div class="mission-rail-words"><span class="mission-label">Từ mục tiêu</span>
            @foreach (var word in Model.TargetWords)
            {
                <span class="mission-word-chip @(word.IsUsed ? "is-used" : "")" data-word="@word.Term"><span><strong>@word.Term</strong><small>@word.Definition</small></span>@if(word.IsUsed){<i class="ph ph-check"></i>}</span>
            }
        </div>
        <div class="mission-situation"><span class="mission-label">Tình huống</span><p>@Model.Mission.Situation</p></div>
        <a class="mission-exit" href="/Study/@Model.SetId"><i class="ph ph-sign-out"></i> Rời mission</a>
    </aside>

    <section class="mission-chat-main">
        <header class="mission-chat-header"><div><span class="mission-eyebrow">English Mission / @Model.SetTitle</span><h1>@Model.Mission.Title</h1><p>Luyện phản xạ bằng cách trả lời tự nhiên và đưa từ mục tiêu vào hội thoại.</p></div><span class="mission-live" aria-label="Mission đang diễn ra"><i aria-hidden="true"></i> Đang diễn ra</span></header>
        <div id="mission-transcript"
             class="mission-chat-stage"
             role="log"
             aria-label="Nội dung hội thoại"
             aria-live="polite"
             aria-relevant="additions">
            <div class="mission-context"><span class="mission-context-icon"><i class="ph ph-chats-circle"></i></span><span><strong>@Model.Mission.NpcName</strong><small>@Model.Mission.NpcRole</small></span></div>
            <div class="mission-message mission-message-npc"><span class="mission-avatar" aria-hidden="true">AI</span><div><small>@Model.Mission.NpcName</small><p lang="en">@Model.Mission.OpeningLine</p><button class="mission-play" type="button" aria-label="Nghe lại câu của @Model.Mission.NpcName"><i class="ph ph-speaker-high" aria-hidden="true"></i> Nghe lại</button></div></div>
            @foreach (var turn in Model.Turns)
            {
                <div class="mission-message mission-message-user"><div><small>Bạn</small><p lang="en">@turn.UserText</p></div><span class="mission-avatar mission-avatar-user" aria-hidden="true">YOU</span></div>
                <div class="mission-message mission-message-npc"><span class="mission-avatar" aria-hidden="true">AI</span><div><small>@Model.Mission.NpcName</small><p lang="en">@turn.NpcText</p><button class="mission-play" type="button" aria-label="Nghe lại câu của @Model.Mission.NpcName"><i class="ph ph-speaker-high" aria-hidden="true"></i> Nghe lại</button>@if(!string.IsNullOrWhiteSpace(turn.FeedbackVi)){<span class="mission-message-note"><i class="ph ph-check-circle" aria-hidden="true"></i> @turn.FeedbackVi</span>}@if(!string.IsNullOrWhiteSpace(turn.CorrectionEn)){<div class="mission-correction"><strong>Tự nhiên hơn</strong><span lang="en">@turn.CorrectionEn</span><small>@turn.CorrectionExplanationVi</small></div>}</div></div>
            }
        </div>
        <div id="mission-error" class="mission-request-error" role="alert" hidden><i class="ph ph-warning-circle" aria-hidden="true"></i><div><strong>Không thể kết nối gia sư AI</strong><p></p></div><button type="button" id="mission-retry">Thử lại</button></div>
        <div class="mission-response-dock">
            <section class="mission-suggestion @(string.IsNullOrWhiteSpace(Model.Mission.SuggestedReplyEn) ? "is-empty" : "")" data-mission-suggestion aria-label="Gợi ý câu trả lời mẫu">
                <div class="mission-suggestion-heading"><span><i class="ph ph-lightbulb" aria-hidden="true"></i> Gợi ý trả lời</span><small>Nhấn để dùng câu mẫu</small></div>
                <button class="mission-suggestion-copy" type="button">
                    <strong data-suggestion-en lang="en">@Model.Mission.SuggestedReplyEn</strong>
                    <span data-suggestion-vi lang="vi">@Model.Mission.SuggestedReplyVi</span>
                </button>
            </section>
            <form id="mission-composer" class="mission-composer" onsubmit="return false">
                <label class="mission-composer-label" for="mission-answer">Câu trả lời bằng tiếng Anh</label>
                <textarea id="mission-answer" rows="2" maxlength="1000" placeholder="Viết câu trả lời của bạn..." aria-describedby="mission-composer-hint" lang="en"></textarea>
                <div class="mission-composer-actions"><span id="mission-composer-hint">Nhấn <kbd>Enter</kbd> để gửi · Shift + Enter để xuống dòng</span><button id="mission-send" class="mission-send" type="button" aria-label="Gửi câu trả lời"><i class="ph ph-arrow-up" aria-hidden="true"></i></button></div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/english-mission.js" asp-append-version="true"></script>
}
