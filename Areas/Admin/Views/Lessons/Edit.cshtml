@model AdminLessonEditViewModel
@{
    string title = Model.Id.HasValue ? "Sửa bài học" : "Tạo bài học";
    ViewData["Title"] = title;
    ViewData["Heading"] = title;
}
<link rel="stylesheet" href="~/css/admin/lessons.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/lessons.css" asp-append-version="true" />

@if (TempData["AdminLessonsSuccess"] is string success)
{
    <div class="admin-alert admin-alert--success" data-popup="success">@success</div>
}

<section class="admin-panel">
    <p class="admin-lesson-meta-links">
        <a class="admin-text-link" href="/Admin/Lessons">← Quay lại danh sách</a>
        @if (Model.Id.HasValue)
        {
            <span aria-hidden="true">·</span>
            <a class="admin-text-link" href="/Admin/Lessons/@Model.Id/Questions">Câu hỏi</a>
            <span aria-hidden="true">·</span>
            <a class="admin-text-link" href="/Admin/Lessons/@Model.Id/Preview">Xem trước trang riêng</a>
        }
    </p>

    <form method="post" action="/Admin/Lessons/Save" class="admin-lesson-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--danger"></div>

        <div class="admin-filter-field">
            <label asp-for="Title"></label>
            <input asp-for="Title" maxlength="200" autocomplete="off" />
            <span asp-validation-for="Title"></span>
        </div>

        <div class="admin-filter-field">
            <label asp-for="Summary"></label>
            <textarea asp-for="Summary" maxlength="500" rows="3"></textarea>
            <span asp-validation-for="Summary"></span>
        </div>

        <div class="admin-filter-field">
            <label asp-for="ContentMarkdown"></label>
            <textarea asp-for="ContentMarkdown" rows="18" class="admin-markdown-input"></textarea>
            <span asp-validation-for="ContentMarkdown"></span>
        </div>

        <div class="admin-lesson-form-row">
            <div class="admin-filter-field">
                <label asp-for="Status"></label>
                <select asp-for="Status">
                    <option value="Draft">Nháp</option>
                    <option value="Published">Đã đăng</option>
                </select>
            </div>

            @if (Model.Id.HasValue)
            {
                <div class="admin-filter-field">
                    <label asp-for="SortOrder"></label>
                    <input asp-for="SortOrder" type="number" />
                </div>
            }
        </div>

        <div class="admin-lesson-form-actions">
            <button type="submit" class="admin-filter-submit">Lưu</button>
        </div>
    </form>
</section>

@if (!string.IsNullOrEmpty(Model.PreviewHtml))
{
    <section class="admin-panel admin-lesson-preview">
        <h2>Xem trước</h2>
        <div class="ls-prose">@Html.Raw(Model.PreviewHtml)</div>
    </section>
}
