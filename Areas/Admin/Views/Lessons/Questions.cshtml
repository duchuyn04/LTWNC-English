@model AdminLessonQuestionsViewModel
@{
    ViewData["Title"] = "Câu hỏi";
    ViewData["Heading"] = "Câu hỏi ôn tập";
}
<link rel="stylesheet" href="~/css/admin/lessons.css" asp-append-version="true" />

@if (TempData["AdminLessonsSuccess"] is string success)
{
    <div class="admin-alert admin-alert--success" data-popup="success">@success</div>
}
@if (TempData["AdminLessonsError"] is string error)
{
    <div class="admin-alert admin-alert--danger" data-popup="error">@error</div>
}

<section class="admin-panel">
    <p class="admin-lesson-meta-links">
        <a class="admin-text-link" href="/Admin/Lessons">← Danh sách</a>
        <span aria-hidden="true">·</span>
        <a class="admin-text-link" href="/Admin/Lessons/@Model.LessonId/Edit">Sửa bài</a>
    </p>

    <div class="admin-panel-header" style="margin-bottom:1rem">
        <div>
            <h2>@Model.LessonTitle</h2>
            <p>Thêm câu trắc nghiệm hoặc câu viết. Thứ tự theo danh sách dưới.</p>
        </div>
    </div>

    @if (Model.Questions.Count == 0)
    {
        <p class="admin-empty">Chưa có câu hỏi. Thêm bên dưới.</p>
    }
    else
    {
        <div class="admin-table-wrapper" style="margin-bottom:1.5rem">
            <table class="admin-table">
                <thead>
                    <tr><th>Loại</th><th>Đề</th><th>Chi tiết</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (AdminLessonQuestionRowViewModel q in Model.Questions)
                {
                    <tr>
                        <td>@q.TypeLabel</td>
                        <td><strong>@q.Prompt</strong></td>
                        <td>@q.Meta</td>
                        <td>
                            <form method="post" action="/Admin/Lessons/@Model.LessonId/Questions/@q.Id/Delete" class="admin-inline-action-form"
                                  onsubmit="return confirm('Xóa câu hỏi này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="admin-text-link" style="background:none;border:0;cursor:pointer;padding:0">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--danger"></div>

    <div class="admin-lesson-section">
        <h3>Thêm câu trắc nghiệm</h3>
        <form method="post" action="/Admin/Lessons/@Model.LessonId/Questions/AddMcq" class="admin-lesson-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="McqForm.LessonId" />

            <div class="admin-filter-field">
                <label asp-for="McqForm.Prompt"></label>
                <textarea asp-for="McqForm.Prompt" rows="3" required></textarea>
            </div>
            <div class="admin-lesson-form-row">
                <div class="admin-filter-field">
                    <label asp-for="McqForm.OptionA"></label>
                    <input asp-for="McqForm.OptionA" required />
                </div>
                <div class="admin-filter-field">
                    <label asp-for="McqForm.OptionB"></label>
                    <input asp-for="McqForm.OptionB" required />
                </div>
            </div>
            <div class="admin-lesson-form-row">
                <div class="admin-filter-field">
                    <label asp-for="McqForm.OptionC"></label>
                    <input asp-for="McqForm.OptionC" />
                </div>
                <div class="admin-filter-field">
                    <label asp-for="McqForm.OptionD"></label>
                    <input asp-for="McqForm.OptionD" />
                </div>
            </div>
            <div class="admin-filter-field" style="max-width:12rem">
                <label asp-for="McqForm.CorrectOptionIndex"></label>
                <select asp-for="McqForm.CorrectOptionIndex">
                    <option value="0">A</option>
                    <option value="1">B</option>
                    <option value="2">C</option>
                    <option value="3">D</option>
                </select>
            </div>
            <div class="admin-lesson-form-actions">
                <button type="submit" class="admin-filter-submit">Thêm trắc nghiệm</button>
            </div>
        </form>
    </div>

    <div class="admin-lesson-section">
        <h3>Thêm câu viết</h3>
        <form method="post" action="/Admin/Lessons/@Model.LessonId/Questions/AddWriting" class="admin-lesson-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="WritingForm.LessonId" />

            <div class="admin-filter-field">
                <label asp-for="WritingForm.Prompt"></label>
                <textarea asp-for="WritingForm.Prompt" rows="3" required></textarea>
            </div>
            <div class="admin-filter-field">
                <label asp-for="WritingForm.AcceptedAnswersText"></label>
                <textarea asp-for="WritingForm.AcceptedAnswersText" rows="4" required
                          placeholder="works&#10;work"></textarea>
                <small class="admin-muted-line">Mỗi dòng một đáp án. Chấm không phân biệt hoa thường, bỏ khoảng trắng thừa.</small>
            </div>
            <div class="admin-lesson-form-actions">
                <button type="submit" class="admin-filter-submit">Thêm câu viết</button>
            </div>
        </form>
    </div>
</section>
