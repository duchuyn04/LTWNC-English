@model AdminLessonEditViewModel
@{
    ViewData["Title"] = "Xem trước bài học";
    ViewData["Heading"] = "Xem trước";
}
<link rel="stylesheet" href="~/css/admin/lessons.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/lessons.css" asp-append-version="true" />

<section class="admin-panel admin-lesson-preview">
    <p class="admin-lesson-meta-links">
        <a class="admin-text-link" href="/Admin/Lessons/@Model.Id/Edit">← Sửa</a>
        <span aria-hidden="true">·</span>
        <a class="admin-text-link" href="/Admin/Lessons">Danh sách</a>
        <span aria-hidden="true">·</span>
        <a class="admin-text-link" href="/Admin/Lessons/@Model.Id/Questions">Câu hỏi</a>
    </p>

    <p class="admin-muted-line">Trạng thái: @(Model.Status == "Published" ? "Đã đăng" : "Nháp")</p>
    <h2 style="margin:0.35rem 0 0.5rem;font-size:1.5rem">@Model.Title</h2>
    @if (!string.IsNullOrWhiteSpace(Model.Summary))
    {
        <p class="admin-muted-line" style="margin-bottom:1rem">@Model.Summary</p>
    }
    <div class="ls-prose">@Html.Raw(Model.PreviewHtml)</div>
</section>
