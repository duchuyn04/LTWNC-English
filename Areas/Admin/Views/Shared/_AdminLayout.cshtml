@{
    // FILE: Shell Admin — sidebar, heading ViewData["Heading"], active menu.
    // currentController từ RouteData; GetMenuClass / GetAriaCurrent cho a11y.
    // Menu: Dashboard, Users, ContentReports, Credits, AuditLogs.
    // CSS admin-*; không dùng nav user thường.
    string pageHeading = ViewData["Heading"] as string ?? "Quản trị hệ thống";

    // Tên controller cho biết mục menu nào đang được mở.
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";

    // Trả về class active khi menu thuộc controller hiện tại.
    string GetMenuClass(string controllerName)
    {
        if (string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase))
        {
            return "active";
        }

        return string.Empty;
    }

    // Hỗ trợ trình đọc màn hình nhận biết trang hiện tại.
    string? GetAriaCurrent(string controllerName)
    {
        if (string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase))
        {
            return "page";
        }

        return null;
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@ViewData["Title"] - LTWNC Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/phosphor-icons@1.4.2/src/css/icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/responsive.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/popup.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <a class="admin-skip-link" href="#admin-main">Bỏ qua điều hướng</a>
    <div class="admin-shell">
        <header class="admin-mobile-bar">
            <a class="admin-mobile-brand" href="/Admin" aria-label="Trang tổng quan LTWNC Admin">
                <span aria-hidden="true">LT</span>
                <strong>LTWNC Admin</strong>
            </a>
            <button type="button"
                    class="admin-menu-toggle"
                    data-admin-menu-toggle
                    aria-expanded="false"
                    aria-controls="admin-sidebar">
                <i class="ph ph-list" aria-hidden="true"></i>
                <span>Menu</span>
            </button>
        </header>

        <aside id="admin-sidebar" class="admin-sidebar" data-admin-menu-panel aria-label="Điều hướng quản trị">
            <a class="admin-brand" href="/Admin" aria-label="Trang tổng quan LTWNC Admin">
                <span aria-hidden="true">LT</span>
                <strong>LTWNC</strong>
                <small>ADMIN</small>
            </a>

            <nav class="admin-navigation" aria-label="Chức năng quản trị">
                <div class="admin-navigation-group">
                    <a class="@GetMenuClass("Dashboard")" href="/Admin" aria-current="@GetAriaCurrent("Dashboard")">
                        <i class="ph ph-squares-four" aria-hidden="true"></i><span>Tổng quan</span>
                    </a>
                    <a class="@GetMenuClass("ContentReports")" href="/Admin/ContentReports" aria-current="@GetAriaCurrent("ContentReports")">
                        <i class="ph ph-flag" aria-hidden="true"></i><span>Báo cáo cần xử lý</span>
                    </a>
                    <a class="@GetMenuClass("Users")" href="/Admin/Users" aria-current="@GetAriaCurrent("Users")">
                        <i class="ph ph-users-three" aria-hidden="true"></i><span>Người dùng</span>
                    </a>
                    <a class="@GetMenuClass("Credits")" href="/Admin/Credits" aria-current="@GetAriaCurrent("Credits")">
                        <i class="ph ph-lightning" aria-hidden="true"></i><span>Tín dụng & thanh toán</span>
                    </a>
                    <a class="@GetMenuClass("Lessons")" href="/Admin/Lessons" aria-current="@GetAriaCurrent("Lessons")">
                        <i class="ph ph-book-open" aria-hidden="true"></i><span>Bài học</span>
                    </a>
                    <a class="@GetMenuClass("AuditLogs")" href="/Admin/AuditLogs" aria-current="@GetAriaCurrent("AuditLogs")">
                        <i class="ph ph-scroll" aria-hidden="true"></i><span>Nhật ký quản trị</span>
                    </a>
                </div>
            </nav>

            <div class="admin-sidebar-footer">
                <a class="admin-learner-link" href="/Set" target="_blank" rel="noopener noreferrer">
                    <i class="ph ph-arrow-square-out" aria-hidden="true"></i>
                    <span>Mở giao diện người học</span>
                </a>
                <div class="admin-account">
                    <span class="admin-avatar" aria-hidden="true">AD</span>
                    <p><strong>@User.Identity?.Name</strong><small>Quản trị viên</small></p>
                    <form action="/Account/Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" title="Đăng xuất" aria-label="Đăng xuất">
                            <i class="ph ph-sign-out" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>
        <button type="button"
                class="admin-sidebar-backdrop"
                data-admin-menu-backdrop
                hidden
                aria-label="Đóng menu"></button>

        <div class="admin-workspace">
            <header class="admin-topbar">
                <div class="admin-page-title">
                    <h1>@pageHeading</h1>
                </div>
            </header>
            <main id="admin-main" class="admin-main" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="/js/admin-shell.js" asp-append-version="true"></script>
    <script src="/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
