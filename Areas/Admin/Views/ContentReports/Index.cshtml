@model AdminContentReportIndexViewModel
@{
    ViewData["Title"] = "Báo cáo nội dung";
    ViewData["Heading"] = "Báo cáo cần xử lý";
}

@if (TempData["ContentReportsSuccess"] is string successMessage)
{
    <div class="admin-alert admin-alert--success" role="status">@successMessage</div>
}

@if (TempData["ContentReportsError"] is string errorMessage)
{
    <div class="admin-alert admin-alert--danger" role="alert">@errorMessage</div>
}

<nav class="admin-tab-list" aria-label="Trạng thái báo cáo">
    <a class="@(!Model.ShowsQuarantined ? "active" : null)" href="/Admin/ContentReports">Chờ xử lý</a>
    <a class="@(Model.ShowsQuarantined ? "active" : null)" href="/Admin/ContentReports?status=quarantined">Đã cách ly</a>
</nav>

<section class="admin-panel" aria-labelledby="content-report-table-heading">
    <div class="admin-panel-header">
        <h2 id="content-report-table-heading">@(Model.ShowsQuarantined ? "Bộ thẻ đã cách ly" : "Báo cáo đang chờ")</h2>
        <p>@Model.TotalCount mục · trang @Model.Page/@Model.TotalPages</p>
    </div>

    @if (Model.Items.Count == 0)
    {
        <p class="admin-empty">Không có mục nào.</p>
    }
    else
    {
        <div class="admin-table-wrapper">
            <table class="admin-table admin-content-report-table">
                <thead>
                    <tr>
                        <th scope="col">Báo cáo</th>
                        <th scope="col">Bộ flashcard</th>
                        <th scope="col">Người gửi</th>
                        <th scope="col">Lý do</th>
                        <th scope="col">Thời gian</th>
                        <th scope="col">Xử lý</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AdminContentReportRowViewModel report in Model.Items)
                    {
                        <tr>
                            <td><strong>#@report.Id</strong></td>
                            <td>
                                <strong>@report.FlashcardSetTitle</strong>
                                <small class="admin-muted-line">Chủ sở hữu: @report.OwnerDisplay</small>
                            </td>
                            <td>@report.ReporterDisplay</td>
                            <td>
                                <strong>@report.ReasonLabel</strong>
                                @if (!string.IsNullOrWhiteSpace(report.Description))
                                {
                                    <small class="admin-muted-line">@report.Description</small>
                                }
                            </td>
                            <td>
                                @report.CreatedAtDisplay
                                <small class="admin-muted-line">@report.AgeDisplay</small>
                            </td>
                            <td>
                                @if (report.CanDismiss)
                                {
                                    <form method="post" action="/Admin/ContentReports/@report.Id/Dismiss"
                                          class="admin-inline-action-form"
                                          onsubmit="return confirm('Bác bỏ báo cáo này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Version" value="@report.Version" />
                                        <label for="dismiss-reason-@report.Id">Lý do</label>
                                        <textarea id="dismiss-reason-@report.Id" name="Reason" maxlength="500" required></textarea>
                                        <button type="submit" class="admin-filter-submit">Bác bỏ</button>
                                    </form>
                                    <form method="post" action="/Admin/ContentReports/@report.Id/Quarantine"
                                          class="admin-inline-action-form"
                                          onsubmit="return confirm('Cách ly bộ flashcard này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ReportVersion" value="@report.Version" />
                                        <input type="hidden" name="FlashcardSetVersion" value="@report.FlashcardSetVersion" />
                                        <label for="quarantine-reason-@report.Id">Lý do công khai</label>
                                        <textarea id="quarantine-reason-@report.Id" name="PublicReason" maxlength="500" required></textarea>
                                        <label class="admin-checkbox-line">
                                            <input type="checkbox" name="Confirmed" value="true" required />
                                            Xác nhận cách ly
                                        </label>
                                        <button type="submit" class="admin-filter-submit admin-button-danger">Cách ly</button>
                                    </form>
                                }
                                else if (report.CanRestore)
                                {
                                    <form method="post" action="/Admin/ContentReports/Restore/@report.FlashcardSetId"
                                          class="admin-inline-action-form"
                                          onsubmit="return confirm('Khôi phục bộ flashcard này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="FlashcardSetVersion" value="@report.FlashcardSetVersion" />
                                        <label for="restore-reason-@report.Id">Lý do khôi phục</label>
                                        <textarea id="restore-reason-@report.Id" name="Reason" maxlength="500" required></textarea>
                                        <label class="admin-checkbox-line">
                                            <input type="checkbox" name="Confirmed" value="true" required />
                                            Xác nhận khôi phục
                                        </label>
                                        <button type="submit" class="admin-filter-submit">Khôi phục</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="admin-pagination" aria-label="Phân trang báo cáo">
            @if (Model.HasPreviousPage)
            {
                <a href="@PageUrl(Model.Page - 1)">Trang trước</a>
            }
            <span aria-current="page">Trang @Model.Page / @Model.TotalPages</span>
            @if (Model.HasNextPage)
            {
                <a href="@PageUrl(Model.Page + 1)">Trang sau</a>
            }
        </nav>
    }
</section>

@functions {
    private string PageUrl(int page)
    {
        string status = Model.ShowsQuarantined ? "&status=quarantined" : string.Empty;
        return $"/Admin/ContentReports?page={page}{status}";
    }
}
