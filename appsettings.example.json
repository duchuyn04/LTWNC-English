{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=LTWNC-English;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UserName": "your-sender@gmail.com",
    "Password": "use-a-gmail-app-password",
    "From": "your-sender@gmail.com",
    "EnableSsl": true
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "AiProviders": {
    "AllowPrivateNetworks": false,
    "Routing": {
      "OverallTimeoutSeconds": 90
    },
    "Providers": [
      {
        "Name": "Example OpenAI-compatible provider",
        "AdapterType": "OpenAICompatible",
        "BaseUrl": "https://your-provider.example/v1",
        "ModelId": "your-model-id",
        "ApiKey": "",
        "IsEnabled": true,
        "IsPrimary": true,
        "Priority": 1,
        "TimeoutSeconds": 60
      }
    ]
  },
  "SePay": {
    "Environment": "Sandbox",
    "MerchantId": "YOUR_MERCHANT_ID",
    "SecretKey": "YOUR_CHECKOUT_SECRET",
    "IpnSecret": "YOUR_IPN_SECRET",
    "PublicBaseUrl": "https://your-public-domain.example"
  }
}
