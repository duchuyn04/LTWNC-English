{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=LTWNC-English;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "AiProviders": {
    "Routing": {
      "OverallTimeoutSeconds": 90
    },
    "Health": {
      "WindowMinutes": 5,
      "MinimumSampleSize": 20,
      "ErrorRateThresholdPercent": 10,
      "UnstableFailureThreshold": 3
    }
  },
  "SePay": {
    "Environment": "Sandbox",
    "MerchantId": "YOUR_MERCHANT_ID",
    "SecretKey": "YOUR_CHECKOUT_SECRET",
    "IpnSecret": "YOUR_IPN_SECRET",
    "PublicBaseUrl": "https://your-public-domain.example"
  }
}
